<section class="explore-tags py-10 md:pt-20 md:pb-10 rounded-tl-[30px] md:rounded-tl-[60px] rounded-tr-[30px] md:rounded-tr-[60px] relative mt-[-60px] bg-primary-bg">
    <div class="container mx-auto">
        <div class="explore-tags-wrapper">
            {{#get "pages" filter="tag:hash-section-tag-cards" limit="1"}}
            {{#if pages}}
            {{#foreach pages}}
            <div class="explore-tags-header mb-7.5 md:mb-12.5 max-w-[320px] md:max-w-[676px] m-auto text-center" >
                {{#if excerpt}}
                <div
                    class="inline-flex uppercase tracking-wider font-semibold items-center justify-center rounded-full border border-secondary-border bg-secondary-bg px-5 py-2 text-xs mb-4.5 md:mb-6">
                    {{excerpt}}
                </div>
                {{/if}}
                {{#match title "!=" "(Untitled)"}}
                    <h2 class="text-2xl md:text-5xl font-bold">{{title}}</h2>
                {{/match}}
                 <div class="text-sm md:text-base mt-5">{{content}}</div>
            </div>
            {{/foreach}}
            {{/if}}
            {{/get}}
            <div class="grid grid-cols-2 lg:grid-cols-4 gap-2.5 md:gap-7">
                {{#get "tags" filter="visibility:public" limit="100" include="count.posts"}} {{#foreach tags}}
                <a href="/tag/{{slug}}/" class="relative block rounded-2xl overflow-hidden group explore-tags-item tag-item hidden">
                    <div class="aspect-square bg-secondary-bg">
                        <img loading="lazy" src="{{#if feature_image}}{{feature_image}}{{else}}{{asset "images/no-image.png"}}{{/if}}"
                            alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{"no image"}}{{/if}}"
                            class="object-cover transition-transform duration-500 group-hover:scale-105">
                    </div>
                    <div class="absolute inset-0 flex flex-wrap content-end justify-between items-end p-2.5 md:p-4.5 gap-1.5">
                        <div class="bg-white text-black text-xs h3 font-medium md:text-base break-all px-3 md:px-6 py-1.5 md:py-2.5 rounded-3xl">
                            <div class="overflow-hidden relative">
                                <p class="group-hover:translate-y-[-120%] transition-transform duration-500">
                                    {{name}}
                                </p>
                                <p class="absolute bottom-[-100%] group-hover:bottom-[0] duration-500 transition-bottom">
                                    {{name}}
                                </p>
                            </div>
                        </div>
                        <p class="text-xs md:text-base text-white bg-white/20 backdrop-blur-xl px-3 md:px-5 py-1.5 md:py-2.5 rounded-3xl">
                            {{plural count.posts empty="0 Articles" singular="1 Article" plural="% Articles"}}
                        </p>
                    </div>
                </a>
                {{/foreach}} {{/get}}
            </div>
           <div class="flex items-center justify-center mt-12.5 gap-5">
            <button id="loadMoreTagsBtn" class="load-more-btn text-sm font-semibold cursor-pointer transition flex items-center justify-center gap-1.5">
                Load More    
                <svg width="10" height="10" viewBox="0 0 30 30" fill="none" class="animate-bounce mt-1">
                <path d="M14.7996 28.3932C14.4586 28.3932 14.1172 28.2623 13.8569 28.0008L0.523563 14.608C0.00256252 14.0846 0.00256252 13.2372 0.523563 12.7142C1.04456 12.1912 1.88823 12.1909 2.4089 12.7142L14.7996 25.1602L27.1902 12.7142C27.7112 12.1909 28.5549 12.1909 29.0756 12.7142C29.5962 13.2375 29.5966 14.085 29.0756 14.608L15.7422 28.0008C15.4819 28.2623 15.1406 28.3932 14.7996 28.3932ZM15.7422 17.2865L29.0756 3.89367C29.5966 3.37034 29.5966 2.52291 29.0756 1.99992C28.5546 1.47693 27.7109 1.47659 27.1902 1.99992L14.7996 14.4459L2.4089 1.99992C1.8879 1.47659 1.04423 1.47659 0.523563 1.99992C0.00289583 2.52324 0.00256252 3.37067 0.523563 3.89367L13.8569 17.2865C14.1172 17.548 14.4586 17.6789 14.7996 17.6789C15.1406 17.6789 15.4819 17.548 15.7422 17.2865Z" fill="currentColor"/>
                </svg>

            </button>
             <button id="showLessTagsBtn" class="show-less-btn items-center text-sm font-semibold
                cursor-pointer transition hidden">
                Show Less
                <svg width="10" height="10" viewBox="0 0 30 30" fill="none" class="animate-bounce rotate-180 mt-[-4px]">
                <path d="M14.7996 28.3932C14.4586 28.3932 14.1172 28.2623 13.8569 28.0008L0.523563 14.608C0.00256252 14.0846 0.00256252 13.2372 0.523563 12.7142C1.04456 12.1912 1.88823 12.1909 2.4089 12.7142L14.7996 25.1602L27.1902 12.7142C27.7112 12.1909 28.5549 12.1909 29.0756 12.7142C29.5962 13.2375 29.5966 14.085 29.0756 14.608L15.7422 28.0008C15.4819 28.2623 15.1406 28.3932 14.7996 28.3932ZM15.7422 17.2865L29.0756 3.89367C29.5966 3.37034 29.5966 2.52291 29.0756 1.99992C28.5546 1.47693 27.7109 1.47659 27.1902 1.99992L14.7996 14.4459L2.4089 1.99992C1.8879 1.47659 1.04423 1.47659 0.523563 1.99992C0.00289583 2.52324 0.00256252 3.37067 0.523563 3.89367L13.8569 17.2865C14.1172 17.548 14.4586 17.6789 14.7996 17.6789C15.1406 17.6789 15.4819 17.548 15.7422 17.2865Z" fill="currentColor"/>
                </svg>
            </button>
            </div>
        </div>
    </div>
</section>