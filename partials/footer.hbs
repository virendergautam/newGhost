<style>
  @keyframes marquee-scroll {
    from {
      transform: translateX(0);
    }

    to {
      transform: translateX(-50%);
    }
  }

  .animate-marquee-scroll {
    animation: marquee-scroll 25s linear infinite;
    display: flex;
    width: max-content;
  }

  .marquee-container:after {
    position: absolute;
    content: "";
    background: linear-gradient(90deg, var(--color-alternate) 0%, rgba(254, 254, 254, 0) 15%, rgba(252, 252, 252, 0) 85%, var(--color-alternate) 100%);
    inset: 0;
    pointer-events: none;
  }
</style>

<footer
  class="site-footer bg-alternate border-t border-border-light pt-[40px] lg:pt-[50px] xl:pt-[70px] overflow-hidden">
  <div class="container">
    <div class="grid grid-cols-[1fr] md:grid-cols-[1.2fr_2fr] lg:grid-cols-[1fr_2fr_0.5fr] gap-8 sm:gap-6 items-start pb-[40px] xl:pb-[60px]">
      <div class="footer-info md:max-w-[300px]">
        <div class="footer-logo">
          <a class="block relative site-header-logo{{#unless @site.logo}} no-image{{/unless}}" href="{{@site.url}}">
          {{#if @site.logo}}
            <img src="{{@site.logo}}" class="max-w-[120px] light-logo-image" alt="{{@site.title}}">
            {{#if @custom.dark_mode_logo}}
              <img src="{{@custom.dark_mode_logo}}" class="max-w-[120px] dark-logo-image absolute inset-0 w-full h-full object-contain object-top-left" alt="{{@site.title}}">
              {{ else }}
              <img src="{{@site.logo}}" class="max-w-[120px] dark-logo-image absolute inset-0 object-contain w-full h-full  object-top-left" alt="{{@site.title}}">
            {{/if}}
          {{else}}
          <h1 class="text-lg font-semibold text-black dark:text-white">{{@site.title}}</h1>
          {{/if}}
          

        </a>
        </div>
        <p class="text-sm mt-5 pb-4 border-b border-border-light md:border-0 md:pb-0">{{@site.description}}</p>
        <p class="text-xs mt-5 pt-5 hidden md:block">
          <span>{{@custom.footer_copyright_text}}</span>
          <span>Published with
            <a target="_blank" href="https://ghost.org/">Ghost</a> and
            <a target="_blank" href="https://whmcsglobalservices.com/">WHMCS Global Services</a>
          </span>
        </p>
      </div>
      <div id="footerGrid" class="grid grid-cols-1 sm:grid-cols-3 gap-10 sm:gap-6 w-full md:max-w-[85%] md:ml-auto lg:max-w-[75%] lg:mx-auto"></div>
      <div class="author-profile-meta gap-2.5 inline-flex flex-wrap lg:justify-end social-links footer-link"
        data-links="{{@custom.social_links}}"> </div>
      <p class="text-xs block md:hidden">
          <span>{{@custom.footer_copyright_text}}</span>
          <span>Published with
            <a target="_blank" href="https://ghost.org/">Ghost</a> and
            <a target="_blank" href="https://whmcsglobalservices.com/">WHMCS Global Services</a>
          </span>
        </p>
    </div>

      <div class="marquee-container relative w-full pb-[20px] lg:pb-[35px] xl:pb-[50px] flex overflow-hidden">
  <div id="marquee-track" class="flex items-center gap-4 sm:gap-6 md:gap-8 lg:gap-10 whitespace-nowrap animate-marquee-scroll">
    {{@custom.footer_marquee_text}}
  </div>
</div>

  </div>
</footer>


<div id="footerNavSource" hidden>
  {{navigation type="secondary"}}
</div>

<script>
  (function () {
    const source = document.querySelector('#footerNavSource ul');
    const target = document.getElementById('footerGrid');
    if (!source || !target) return;

    const items = Array.from(source.querySelectorAll('li'));

    let currentCol = null;

    items.forEach(li => {
      const a = li.querySelector('a');
      if (!a) return;

      const label = a.textContent.trim();
      const url = a.getAttribute('href');

      // 🔹 COLUMN HEADING
      if (label.startsWith('#')) {
        currentCol = document.createElement('div');
        currentCol.innerHTML = `
        <h2 class="text-xs !text-heading/60 dark:!text-heading mb-3 sm:mb-6">
          ${label.replace(/^#+\s*/, '')}
        </h2>
        <ul class="space-y-4 text-sm"></ul>
      `;
        target.appendChild(currentCol);
        return;
      }

      // 🔹 NORMAL LINK
      if (!currentCol) return;

      const ul = currentCol.querySelector('ul');
      const liEl = document.createElement('li');

      liEl.innerHTML = `
      <a href="${url}" class="block hover:text-accent font-semibold">
        ${label}
      </a>
    `;

      ul.appendChild(liEl);
    });
  })();
</script>