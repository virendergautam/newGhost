<div
  class="group flex flex-col hover:translate-y-[-10px] transition-transform duration-500 ease-in-out"
>
  <a
    href="{{url}}"
    class="relative block aspect-[1/1.2] rounded-2xl overflow-hidden bg-main mb-4 group-hover:shadow-lg transition-shadow duration-500 ease-in-out"
  >
    {{#if profile_image}}
      <img
        src="{{img_url profile_image size=" m"}}"
        alt="{{name}}"
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-in-out"
      />
    {{else}}
      <div class="w-full h-full flex items-center justify-center text-text/20">
        {{> "icons/avatar"}}
      </div>
    {{/if}}
  </a>
  <div class="flex flex-col items-start">
    <h3 class="text-base mb-1">
      <a
        href="{{url}}"
        class="group-hover:text-accent transition-colors"
      >{{name}}</a>
    </h3>
    <p class="text-xs line-clamp-2 mb-3">
      {{#if bio}}{{bio}}{{else}}{{t "Active contributor and creative writer sharing insights and stories."}}{{/if}}
    </p>
    <div
      class="px-3 py-1 min-h-[20px] flex items-center rounded-sm text-xs border border-border-light text-heading"
    >
      {{plural
        count.posts
        empty="No articles"
        singular="% article"
        plural="% articles"
      }}
    </div>

  </div>
</div>