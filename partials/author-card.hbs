<div class="group flex flex-col">
                    <a href="{{url}}"
                        class="relative block aspect-[1/1.2] rounded-2xl overflow-hidden bg-gray-50 mb-4 shadow-sm border border-gray-100">
                        {{#if profile_image}}
                        <img src="{{img_url profile_image size=" m"}}" alt="{{name}}"
                            class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 ease-in-out">
                        {{else}}
                        <div class="w-full h-full flex items-center justify-center text-gray-200">
                            <svg class="w-20 h-20 opacity-30" fill="currentColor" viewBox="0 0 24 24">
                                <path
                                    d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
                            </svg>
                        </div>
                        {{/if}}
                        <div class="absolute inset-0 bg-black/5 opacity-0 group-hover:opacity-100 transition-opacity">
                        </div>
                    </a>
                    <div class="flex flex-col">
                        <h3 class="text-base font-bold leading-tight mb-1">
                            <a href="{{url}}" class="hover:text-[#0A66C2] transition-colors">{{name}}</a>
                        </h3>
                        <p class="text-[13px] line-clamp-2 leading-relaxed mb-3">
                            {{#if bio}}{{bio}}{{else}}Active contributor and creative writer sharing insights and
                            stories.{{/if}}
                        </p>
                                  <div class="text-xs bg-secondary border border-secondary-border rounded-3xl py-[6px] px-[20px]">
          {{plural count.posts empty="No articles" singular="% article" plural="% articles" }}
        </div>

                    </div>
                </div>