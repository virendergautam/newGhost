<div class="author-group grid grid-cols-[auto_1fr] items-center">
  {{#if authors}}
    <div class="flex -space-x-3 mr-3">
      {{#foreach authors}}
        {{#if profile_image}}
          <img
            src="{{img_url profile_image size=" xs"}}"
            alt="{{name}}"
            class="md:w-9 md:h-9 w-7 h-7 rounded-full object-cover border-2 border-main"
            title="{{name}}"
          />
        {{else}}
          <div
            class="md:w-9 md:h-9 w-7 h-7 rounded-full bg-gray-300 flex items-center justify-center text-[10px] text-gray-400 p-2"
            title="{{name}}"
          >
            {{> "icons/avatar"}}
          </div>
        {{/if}}
      {{/foreach}}
    </div>
  {{/if}}
  <div class="flex flex-col justify-center">
    <h4 class="text-sm">
      {{#foreach authors}}{{name}}{{#unless @last}}, {{/unless}}{{/foreach}}
    </h4>
    <p class="text-xs mt-0.5">{{t "Published on"}}
      {{date format="DD MMM YYYY"}}</p>
  </div>
</div>