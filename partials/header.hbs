<header id="siteHeader" class="header relative{{#match @custom.header_layout "Fixed layout"}} fixed-layout {{/match}}
  {{#match @custom.header_layout "Sticky fullwidth" }} fullwidth-sticky header-sticky top-[0px] z-3 {{else match
  @custom.header_layout "Sticky fixed layout" }} fixed-sticky header-sticky top-[20px] z-3{{/match}}">
  <div class="container {{#match @custom.header_layout "Fixed layout"}}relative{{else match
    @custom.header_layout "Sticky fixed layout" }}relative{{/match}}">
    <div class="background-layer bg-white dark:bg-black"></div>
    <!-- HEADER BAR -->
    <nav
      class="header-inner grid grid-cols-[1fr_auto_1fr] items-center min-h-[50px] py-1.5 gap-6 relative text-black dark:text-white">

      <!-- LOGO -->
      <div class="header-logo">
        <a class="block relative site-header-logo{{#unless @site.logo}} no-image{{/unless}}" href="{{@site.url}}">
          {{#if @site.logo}}
            <img src="{{@site.logo}}" class="max-w-[150px] light-logo-image" alt="{{@site.title}}">
            {{#if @custom.dark_mode_logo}}
              <img src="{{@custom.dark_mode_logo}}" class="max-w-[150px] dark-logo-image absolute inset-0 w-full h-full object-contain object-top-left" alt="{{@site.title}}">
              {{ else }}
              <img src="{{@site.logo}}" class="max-w-[150px] dark-logo-image absolute inset-0 object-contain w-full h-full  object-top-left" alt="{{@site.title}}">
            {{/if}}
          {{else}}
          <h1 class="text-lg font-semibold text-black dark:text-white">{{@site.title}}</h1>
          {{/if}}
          

        </a>
      </div>

      <!-- DESKTOP NAV -->
      <nav class="nav-menu hidden lg:flex w-full justify-center items-center gap-6">
        {{navigation}}
      </nav>

      <!-- RIGHT SIDE -->
      <div class="flex items-center justify-end gap-4">
        <div class="flex items-center">
          <!-- SEARCH -->
          <button aria-label="Search"
            class="gh-search min-w-12 flex items-center justify-center hover:text-accent cursor-pointer"
            data-ghost-search>
            {{> "icons/search"}}
          </button>

          {{#match @custom.appearance "User defined"}}
          <button aria-label="Toggle theme" id="theme-toggle"
            class="min-w-12 border-l flex items-center justify-center hover:text-accent cursor-pointer">
            <span class="icon-dark">
              {{> "icons/dark-mode"}}
            </span>
            <span class="icon-light hidden">
              {{> "icons/light-mode"}}
            </span>
          </button>
          {{/match}}

        </div>
        <div class="flex items-center gap-1.5">
          <!-- MEMBERS -->
          {{#if @site.members_enabled}}
          {{#if @member}}
          <a href="#/portal/account" data-portal="account"
            class="hidden button">
            <span class="button-text relative">Account </span>
          </a>
          {{else}}
          {{#if @site.members_invite_only}}
            <a href="#/portal/signin" data-portal="signin"
            class="hidden button">
            <span class="button-text relative">Sign In </span>
          </a>
          {{else}}
          <a href="#/portal/signup" data-portal="signup" class="hidden button">
            <span class="button-text relative">Subscribe </span>
          </a>
        
          {{/if}}
          {{/if}}
          {{/if}}

          <!-- MOBILE BURGER -->
          <button id="mobileMenuToggle" aria-label="Menu"
            class="w-6 h-6 lg:hidden flex flex-col justify-center gap-1 cursor-pointer">
            <span class="block h-[2px] bg-black"></span>
            <span class="block h-[2px] bg-black"></span>
            <span class="block h-[2px] bg-black"></span>
          </button>

        </div>
      </div>
    </nav>
    <!-- MOBILE MENU -->
    {{!-- <nav id="mobileMenu"
      class="mobile-header-menu hidden lg:hidden mt-4 bg-white border border-[#EBEBEB] rounded-xl p-5">

      <!-- NAVIGATION -->
