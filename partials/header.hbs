<header id="siteHeader" class="header-main">
  <div class="max-w-[1215px] w-[93%] mx-auto relative">

    <!-- HEADER BAR -->
    <div class="header-inner flex items-center gap-6 bg-white/70 backdrop-blur-md border border-[#EBEBEB] p-4 lg:p-2.5 rounded-[50px] mt-[20px] lg:mt-[25px] lg:pl-7.5">

      <!-- LOGO -->
      <div class="header-logo w-24">
        <a class="block site-header-logo{{#unless @site.logo}} no-image{{/unless}}" href="{{@site.url}}">
          {{#if @site.logo}}
            <img src="{{@site.logo}}" alt="{{@site.title}}">
          {{else}}
            {{@site.title}}
          {{/if}}
        </a>
      </div>

      <!-- DESKTOP NAV -->
      <nav class="header-menu hidden lg:flex items-center gap-6">
        {{navigation}}
      </nav>

      <!-- RIGHT SIDE -->
      <div class="flex items-center gap-3 ml-auto">

        <!-- SEARCH -->
        <button aria-label="Search" class="gh-search w-9 h-9 flex items-center justify-center rounded-full hover:bg-gray-100 cursor-pointer" data-ghost-search>
          {{> "icons/search"}}
        </button>

        <!-- MEMBERS -->
        {{#if @site.members_enabled}}
          {{#if @member}}
            <a href="#/portal/account" data-portal="account" class="hidden lg:inline-flex text-sm font-medium">
              Account
            </a>
          {{else}}
            <a href="#/portal/signin" data-portal="signin" class="hidden lg:inline-flex text-sm">
              Sign In
            </a>
            {{#unless @site.members_invite_only}}
              <a href="#/portal/signup" data-portal="signup" class="hidden lg:inline-flex px-4 py-2 bg-black text-white rounded-full text-sm">
                Subscribe
              </a>
            {{/unless}}
          {{/if}}
        {{/if}}

        <!-- MOBILE BURGER -->
        <button id="mobileMenuToggle" aria-label="Menu" class="w-6 h-6 lg:hidden flex flex-col justify-center gap-1 cursor-pointer">
          <span class="block h-[2px] bg-black"></span>
          <span class="block h-[2px] bg-black"></span>
          <span class="block h-[2px] bg-black"></span>
        </button>

      </div>
    </div>

    <!-- MOBILE MENU -->
    <nav id="mobileMenu" class="mobile-header-menu hidden lg:hidden mt-4 bg-white border border-[#EBEBEB] rounded-xl p-5">

      <!-- NAVIGATION -->
      <div class="flex flex-col gap-4">
        {{navigation}}
      </div>

      <!-- MEMBERS (MOBILE) -->
      {{#if @site.members_enabled}}
        <div class="flex flex-col gap-3 mt-5 border-t pt-5">
          {{#if @member}}
            <a href="#/portal/account" data-portal="account" class="text-base">
              Account
            </a>
          {{else}}
            <a href="#/portal/signin" data-portal="signin" class="text-base">
              Sign In
            </a>
            {{#unless @site.members_invite_only}}
              <a href="#/portal/signup" data-portal="signup" class="px-4 py-2 bg-black text-white rounded-full text-center">
                Subscribe
              </a>
            {{/unless}}
          {{/if}}
        </div>
      {{/if}}

    </nav>

  </div>
</header>