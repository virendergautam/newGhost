{{! Article Card for Index Page }}
<article
  class="article-card group bg-white rounded-[20px] p-7 pbe-0 shadow-sm hover:shadow-xl transition-all flex flex-col h-full {{#match @custom.feed_card_layout "Image first"}}
    has-image-first
  {{else}}
    has-heading-first
  {{/match}}"
>
  {{! Category Tag }}
  <div class="mb-4">
    <div class="flex gap-2">
      {{#foreach tags}}
        <span
          class="px-4 py-1 min-h-[20px] flex items-center bg-white rounded-sm text-xs border"
        >{{name}}</span>
      {{/foreach}}
    </div>
  </div>

  {{! Title }}
  <h3
    class="text-md md:text-xl mb-5 leading-tight line-clamp-2 group-hover:text-blue-600 transition-colors"
  >
    <a href="{{url}}">{{title}}</a>
  </h3>

  {{! Featured Image }}
  <div
    class="relative rounded-[14px] overflow-hidden mb-5 bg-[#F3F4F6] text-[#dbdbdb] flex items-center justify-center  {{#match @custom.feed_image_orientation "Landscape"}}
    aspect-[3/2]
  {{else match @custom.feed_image_orientation "Potrait"}}
    aspect-[2/3]
  {{else match @custom.feed_image_orientation "Square"}}
    aspect-square
  {{else}}
    aspect-auto
  {{/match}}""
  >
    {{#if feature_image}}
      <img
        src="{{img_url feature_image size="m"}}"
        alt="{{title}}"
        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
      />
    {{else}}
      <span class="font-bold">NO IMAGE</span>
    {{/if}}
  </div>

  {{! Excerpt }}
  <p class="leading-relaxed line-clamp-3 mb-4">
    {{excerpt}}
  </p>

  {{! Footer Metadata }}
  <div class="mt-auto py-[15px] border-t flex items-center justify-between">
    <div class="flex items-center gap-2 text-xs">
      <svg
        class="w-4 h-4"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      ><path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
        ></path></svg>
      <span>{{date format="MMM DD, YYYY"}}</span>
    </div>

    {{#foreach authors}}
      <div class="flex items-center gap-2.5">
        <span class="text-xs">By {{name}}</span>
        {{#if profile_image}}
          <img
            src="{{img_url profile_image size="xs"}}"
            alt="{{name}}"
            class="w-7 h-7 rounded-full object-cover"
          />
        {{/if}}
      </div>
    {{/foreach}}
  </div>
</article>