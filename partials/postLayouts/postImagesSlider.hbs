  const enableSlider = slides.length > 1;

const swiper = new Swiper(".article-post-slider .swiper", {
  loop: enableSlider,

  autoplay: enableSlider ? {
    delay: 3000,
    disableOnInteraction: false
  } : false,

  effect: "fade",
  fadeEffect: {
    crossFade: true
  },

  // 🔥 IMPORTANT FIXES
  watchSlidesProgress: true,
  observer: true,
  observeParents: true,

  pagination: {
    el: ".post-slider-pagination",
