<div class="post-header mb-12">
  <div class="article-post-slider flex items-end relative bg-alternate min-h-[650px] xl:min-h-[720px] overflow-hidden -mt-[70px]">
    <!-- SWIPER -->
    <div class="absolute inset-0">
      <div class="swiper w-full h-full min-w-[0px]">
        <div class="swiper-wrapper" id="post-slider-wrapper">
          {{!-- FEATURE IMAGE AS FIRST SLIDE --}}
          {{#if feature_image}}
          <div class="swiper-slide">
            <figure class="article-img relative before:absolute before:inset-0 before:bg-black/40 h-full w-full overflow-hidden">
              <img 
                src="{{img_url feature_image size="xl"}}"
                alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                class="w-full h-full object-cover"
              />
            </figure>
          </div>
          {{/if}}
        </div>
      </div>
    </div>
    <!-- CONTENT OVERLAY -->
    <div class="container grid h-full  grid-rows-[1fr_auto_auto] md:grid-rows-[1fr_auto] gap-4 md:gap-7 lg:gap-10 z-1">
      <div class="aricle-heading-wrapper py-5 max-w-[650px] h-full flex">
        <div class="aricle-heading my-auto flex flex-col gap-2">

          <div class="flex items-center gap-2">
            {{> "tagsList"}}
            <p class="text-xs font-medium pl-2">{{reading_time}}</p>
          </div>

          <h2 class="text-3xl md:text-4xl mb-2">{{title}}</h2>

          {{#if custom_excerpt}}
            <p class="article-excerpt ">{{custom_excerpt}}</p>
          {{/if}}

        </div>
      </div>
      <div class="article-info py-6 border-t border-white/15 grid grid-cols-1 md:grid-cols-[1.1fr_auto] gap-3 md:gap-5 lg:gap-7 xl:gap-10 items-start">
        {{> "author-group"}}
        {{> "postContent/postShare"}}
      </div>
    <div class="swiper-pagination post-slider-pagination"></div>
    </div>
  </div>
</div>
{{> "postContent/postContent"}}

<script>
document.addEventListener("DOMContentLoaded", function () {

  const wrapper = document.getElementById("post-slider-wrapper");
  const hiddenContent = document.querySelector(".gh-content");

  if (!wrapper || !hiddenContent) return;

  let slides = [];

  // ✅ 1. Get existing feature image (already rendered)
  const existingSlides = wrapper.querySelectorAll("img");
  existingSlides.forEach(img => {
    slides.push(img.src);
  });

  // ✅ 2. Extract images from post content
  const contentImgs = hiddenContent.querySelectorAll("img");

  contentImgs.forEach((img) => {
    const src = img.src || img.getAttribute("data-src");
        let url = src;


    if (url && !slides.includes(url) && slides.length < 4) {
      slides.push(url);

      wrapper.insertAdjacentHTML("beforeend", `
        <div class="swiper-slide">
          <img src="${url}" class="w-full h-full object-cover"/>
        </div>
      `);
    }
  });

