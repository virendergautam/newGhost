<div class="post-header mb-12">
  <div class="article-post-slider text-white grid h-[450px] md:h-[600px] xl:h-[720px] overflow-hidden -mt-[70px]">
    <div class="swiper col-span-full row-span-full w-full h-full min-w-[0px]">
      <div class="swiper-wrapper">
        <div class="swiper-slide">
          <figure class="article-image w-full overflow-hidden">
            <img srcset="{{img_url feature_image size=" s"}} 300w, {{img_url feature_image size="m" }} 600w, {{img_url
              feature_image size="l" }} 1000w, {{img_url feature_image size="xl" }} 2000w"
              sizes="(min-width: 1400px) 1400px, 92vw" src="{{img_url feature_image size=" xl"}}"
              alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"'' class="w-full block" />
          </figure>
        </div>
      </div>
    </div>
    <div class="container grid col-span-full row-span-full h-full grid-rows-[1fr_auto] gap-10 relative z-1">
      <div class="aricle-heading-wrapper py-5 max-w-[650px] h-full flex">
        <div class="aricle-heading my-auto flex flex-col gap-2">

          <div class="flex items-center gap-2">
            {{> "tagsList"}}
            <span class="text-xs font-medium pl-2">{{reading_time}}</span>
          </div>
          <h2 class="text-5xl mb-2 !text-white">{{title}}</h2>
          {{#if custom_excerpt}}
            <p class="article-excerpt text-white">{{custom_excerpt}}</p>
          {{/if}}
        </div>
      </div>
      <div
        class="article-info py-6 border-t border-white/15 grid grid-cols-1 md:grid-cols-[1.1fr_auto] gap-10 items-start">
        {{> "author-group"}}
        {{> "postContent/postShare"}}
      </div>
    </div>
  </div>
</div>
{{> "postContent/postContent"}}
