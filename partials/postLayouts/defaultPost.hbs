{{!< default}}

{{!-- The tag above means: insert everything in this file
into the {body} tag of the default.hbs template --}}
<div class="container container-sm">
    <div class="aricle-heading-wrapper grid grid-cols-1 lg:grid-cols-[1.5fr_1fr] items-end gap-10 pb-10 {{#match @custom.post_layout "=" "No image layout"}} border-b border-border{{/match}}">
        <div class="aricle-heading lg:max-w-[85%] flex flex-col gap-5">
            <div class="flex items-center gap-2">
                {{> "tagsList"}}
                <span class="text-xs font-medium pl-2">{{reading_time}}</span>
            </div>
            <h2 class="text-5xl mb-2">{{title}}</h2>
            {{> "author-group"}}
        </div>
        <div class="article-info grid gap-15">
            {{#if custom_excerpt}}
                <p class="article-excerpt">{{custom_excerpt}}</p>
            {{/if}}
            <div class="flex items-center flex-wrap gap-4">
                <h6 class="text-base">
                    {{t "Share This Article:"}}
                </h6>
                <div class="flex items-center flex-wrap gap-1.5">
                    <a class="social-link" href="javascript:void(0)" onclick="copyToClipboard('{{url absolute=" true"}}')"
                        rel="noopener">
                        {{> "icons/website"}}
                    </a>
                    <a class="social-link" href="https://www.facebook.com/sharer/sharer.php?u={{url absolute=" true"}}" target="_blank"
                        rel="noopener">
                        {{> "icons/facebook"}}
                    </a>
                    <a class="social-link" href="https://twitter.com/intent/tweet?url={{url absolute=" true"}}&text={{encode title}}"
                        target="_blank" rel="noopener">
                        {{> "icons/twitter"}}
                    </a>
                    <a class="social-link" href="https://www.linkedin.com/sharing/share-offsite/?url={{url absolute=" true"}}"
                        target="_blank" rel="noopener">
                        {{> "icons/linkedin"}}
                    </a>
                    <a class="social-link" href="https://wa.me/?text={{encode title}}%20{{url absolute=" true"}}" target="_blank"
                        rel="noopener">
                        {{> "icons/lock"}}
                    </a>
                </div>
            </div>
        </div>
    </div>
    {{#match @custom.post_layout "!=" "No image layout"}}
    {{> "postContent/postImage"}}
    {{/match}}
</div>