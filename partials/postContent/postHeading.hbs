    <div class="article-heading-wrapper w-full grid grid-cols-1 md:grid-cols-[1fr_1fr] lg:grid-cols-[1.5fr_1fr] items-end gap-3 md:gap-5 xl:gap-10 pb-10 {{#match @custom.post_layout "No image"}} border-b border-border{{/match}} {{#unless feature_image}} border-b border-border{{/unless}}">
        <div class="article-heading lg:max-w-[700px] xl:max-w-[600px] flex flex-col gap-5">
            <div class="flex flex-wrap items-center gap-2">
             {{#foreach tags visibility="public"}}
            {{#if @first}}
            <div class="flex gap-1.5 flex-wrap">
            {{/if}}
            <span
                class="px-3 py-1 min-h-[20px] flex items-center bg-alternate text-heading rounded-sm text-xs border border-border">{{name}}</span>

            {{#if @last}}
            </div>
            {{/if}}
            {{/foreach}} 
                <span class="text-xs font-medium pl-2 whitespace-nowrap">{{reading_time}}</span>
            </div>
            <h2 class="text-3xl md:text-4xl mb-2">{{title}}</h2>
            {{> "author-group"}}
        </div>
        <div class="article-info grid gap-4 md:gap-10 lg:gap-12">
            {{#if custom_excerpt}}
                <p class="article-excerpt text-sm md:text-base emt-3 md:mt-4">{{custom_excerpt}}</p>
            {{/if}}
            {{> "postContent/postShare"}}
        </div>
    </div>