    <div class="aricle-heading-wrapper grid grid-cols-1 lg:grid-cols-[1.5fr_1fr] items-end gap-10 pb-10 {{#match @custom.post_layout "No image"}} border-b border-border{{/match}} {{#unless feature_image}} border-b border-border{{/unless}}">
        <div class="aricle-heading lg:max-w-[700px] flex flex-col gap-5">
            <div class="flex items-center gap-2">
                {{> "tagsList"}}
                <span class="text-xs font-medium pl-2">{{reading_time}}</span>
            </div>
            <h2 class="text-4xl mb-2">{{title}}</h2>
            {{> "author-group"}}
        </div>
        <div class="article-info grid gap-12">
            {{#if custom_excerpt}}
                <p class="article-excerpt mt-4">{{custom_excerpt}}</p>
            {{/if}}
            {{> "postContent/postShare"}}
        </div>
    </div>