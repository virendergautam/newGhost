<div class="article-heading-wrapper w-full">
    <div class="article-heading lg:max-w-[700px] flex flex-col gap-2 md:gap-5">
        <div class="flex flex-wrap items-center gap-2">
            {{#foreach tags visibility="public"}}
              {{#if @first}}
              <div class="flex gap-1.5 flex-wrap">
                {{/if}}
                <span
                  class="px-3 py-1 min-h-[20px] flex items-center bg-alternate text-heading rounded-sm text-xs border border-border">{{name}}</span>

                {{#if @last}}
              </div>
              {{/if}}
              {{/foreach}}
            <span class="text-xs font-medium pl-2 whitespace-nowrap">{{reading_time}}</span>
        </div>
        <h2 class="text-3xl md:text-4xl mb-2">{{title}}</h2>
        {{> "author-group"}}
        {{#if custom_excerpt}}
        <p class="article-excerpt text-sm md:text-base mt-4">{{custom_excerpt}}</p>
        {{/if}}
        {{#match @custom.post_layout "!=" "Sticky content"}}
        {{> "postContent/postShare"}}
        {{/match}}
    </div>

</div>