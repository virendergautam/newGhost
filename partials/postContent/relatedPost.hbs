{{#get "posts" include="tags,authors" filter="id:-{{id}}" limit="4" as |more_posts| }}
{{#if more_posts}}
  <section class="related-posts py-[40px] md:py-[60px] lg:py-[70px] border-t border-border">
    <div class="container">
      <h2 class="text-2xl md:text-3xl mb-5">{{t "You Might Also Like"}}</h2>
      {{!-- This query gets the latest 3 posts on the site, but adds a filter to
      exclude the post we're currently on from being included. --}}
      <div class="related-posts-list grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
        {{#foreach more_posts}}
        {{> "post-card"}}
        {{/foreach}}
      </div>
    </div>
  </section>
{{/if}}
{{/get}}