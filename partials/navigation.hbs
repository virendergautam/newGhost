<ul class="nav-menu-list flex flex-wrap items-center gap-x-4 gap-y-2 lg:gap-x-8 lg:gap-y-4"  data-site-nav>
  {{#foreach navigation}}
    <li class="nav-menu-item relative" data-nav-item>
      <a class="nav-menu-link inline-flex items-center gap-1 text-sm font-bold text-black dark:text-white !p-0 !bg-transparent"
         href="{{url}}">
        {{label}}
      </a>
    </li>
  {{/foreach}}
</ul>

<script>
(function () {
  if (location.pathname.startsWith('/ghost/')) return;

  // const nav = document.getElementById('siteNav');
  const navs = document.querySelectorAll('[data-site-nav]');
navs.forEach(nav => {

  if (!nav) return;

  const items = Array.from(nav.querySelectorAll('[data-nav-item]'));

  // Remove [group] from label text
  function cleanLabel(text) {
    return text.replace(/\s*\[.+?\]/, '').trim();
  }

  // Extract group name from label
  function extractGroup(text) {
    const match = text.match(/\[(.+?)\]/);
    return match ? match[1].toLowerCase() : null;
  }

  // Build nav data
  const navData = items.map(li => {
    const a = li.querySelector('a');
    const rawLabel = a ? a.textContent.trim() : '';
    const label = cleanLabel(rawLabel);

    if (a) a.textContent = label; // 🔥 CLEAN LABEL IN DOM

    return {
      li,
      a,
      rawLabel,
      label
    };
  });

  // Map parents by label
  const parentsByLabel = {};
  navData.forEach(item => {
    if (item.label) {
      parentsByLabel[item.label.toLowerCase()] = item;
    }
  });

  // Build parent → children map
  const childrenMap = new Map();

  navData.forEach(item => {
    const group = extractGroup(item.rawLabel);
    if (!group) return;

    const parent = parentsByLabel[group];
    if (!parent) return;

    if (!childrenMap.has(parent.li)) {
      childrenMap.set(parent.li, []);
    }
    childrenMap.get(parent.li).push(item.li);
  });

  // Create dropdowns
  for (const [parentLI, childLIs] of childrenMap.entries()) {
    const parentA = parentLI.querySelector('a');
    if (!parentA || !childLIs.length) continue;

    parentLI.classList.add('has-dropdown');
    // Add caret icon once
const observer = new MutationObserver(() => {
  if (!parentA.querySelector('[data-caret]')) {
    parentA.insertAdjacentHTML('beforeend', `
        <svg width="7px" height="5px" data-caret viewBox="0 0 7 5" fill="none">
          <path d="M6.03843 0L3.5 2.53843L0.961571 0L0 0.961571L3.5 4.46157L7 0.961571L6.03843 0Z" fill="currentColor"/>
        </svg>

      `);
  }
});

observer.observe(parentA, { childList: true });

    const dropdownUl = document.createElement('ul');
    const dropdown = document.createElement('div');
    dropdown.appendChild(dropdownUl);


    dropdown.className =
      'dropdown absolute left-0 top-full z-50 mt-4 min-w-[170px] rounded-xl bg-white text-black dark:bg-black dark:text-white p-2 ' +
      'opacity-0 invisible translate-y-1 transition';

    childLIs.forEach(childLI => {
      const childA = childLI.querySelector('a');
      if (!childA) return;

      const li = document.createElement('li');
      const a = childA.cloneNode(true);
      a.className = 'block focus-inside rounded-lg px-3 py-2 text-sm font-medium hover:bg-main';

      li.appendChild(a);
      dropdownUl.appendChild(li);

      // Remove from top-level
      childLI.remove();
    });

    parentLI.appendChild(dropdown);

    // CLICK TO TOGGLE
    parentA.addEventListener('click', function (e) {
      e.preventDefault();
      e.stopPropagation();

      document.querySelectorAll('[data-site-nav] li.is-open').forEach(li => {
        if (li !== parentLI) li.classList.remove('is-open');
      });

      parentLI.classList.toggle('is-open');
    });
  }

  // CLICK OUTSIDE TO CLOSE
  document.addEventListener('click', function () {
    document.querySelectorAll('[data-site-nav] li.is-open')
      .forEach(li => li.classList.remove('is-open'));
  });
})
})();
</script>

<style>
[data-site-nav] li.is-open > .dropdown {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
  overflow: hidden;
}

@media (min-width: 767px) {
[data-site-nav] li.is-open > .dropdown > ul {
  max-height: 225px;
  overflow: auto;
}
}
</style>
