{{!< default}} {{!-- The tag above means - insert everything in this file into the {body} of the default.hbs template
    --}} <main id="site-main" class="site-main outer">
    <section class="authors-posts py-[40px] md:py-[60px] lg:py-[70px]">
        <div class="container">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-[auto_1fr] items-start gap-4 md:gap-8 xl:gap-4">
                {{#author}}
                <div class="author-card w-[100%] lg:max-w-[375px] bg-alternate border border-accent rounded-[20px] pt-1 md:sticky top-[var(--header-height)] z-2">
                    <div class="author-card-body p-5 text-center flex flex-col items-center">
                        <div
                            class="author-image bg-main rounded-full overflow-hidden size-[180px] text-text/20 aspect-square  mt-5">
                            {{#if profile_image}}
                            <img src="{{img_url profile_image size=" m"}}" alt="{{name}}"
                                class="w-full h-full object-cover" />
                            {{else}}
                            <div class="w-full h-full p-[10%] flex items-center justify-center">
                                {{> "icons/avatar"}}
                            </div>
                            {{/if}}
                        </div>
                        <div class="author-card-content">
                            <h2 class="text-2xl lg:text-3xl mt-5">{{name}}</h2>
                            <div
                                class="px-3 py-1 min-h-[20px] inline-flex items-center rounded-sm text-xs border border-border-light text-heading mt-4">
                                2 Article
                            </div>
                            {{#if bio}}
                            <div class="text-sm mt-4">{{bio}}</div>
                            {{/if}}
                            <div class="author-profile-meta mt-4 flex gap-2 flex-wrap justify-center">
                                {{#if website}}
                                <a class="social-link" href="{{website}}" target="_blank" rel="noopener">
                                    {{>"icons/website"}}</a>
                                {{/if}}
                                {{#if twitter}}
                                <a class="social-link" href="{{social_url type="twitter"}}" target="_blank"
                                    rel="noopener">{{> "icons/twitter"}}</a>
                                {{/if}}
                                {{#if facebook}}
                                <a class="social-link" href="{{social_url type="facebook"}}" target="_blank"
                                    rel="noopener">{{> "icons/facebook"}}</a>
                                {{/if}}
                                {{#if linkedin}}
                                <a class="social-link" href="{{social_url type="linkedin"}}" target="_blank"
                                    rel="noopener">{{> "icons/linkedin"}}</a>
                                {{/if}}
                                {{#if bluesky}}
                                <a class="social-link" href="{{social_url type="bluesky"}}" target="_blank"
                                    rel="noopener">{{> "icons/bluesky"}}</a>
                                {{/if}}
                                {{#if threads}}
                                <a class="social-link" href="{{social_url type="threads"}}" target="_blank"
                                    rel="noopener">{{> "icons/threads"}}</a>
                                {{/if}}
                                {{#if mastodon}}
                                <a class="social-link" href="{{social_url type="mastodon"}}" target="_blank"
                                    rel="noopener">{{> "icons/mastodon"}}</a>
                                {{/if}}
                                {{#if tiktok}}
                                <a class="social-link" href="{{social_url type="tiktok"}}" target="_blank"
                                    rel="noopener">{{> "icons/tiktok"}}</a>
                                {{/if}}
                                {{#if youtube}}
                                <a class="social-link" href="{{social_url type="youtube"}}" target="_blank"
                                    rel="noopener">{{> "icons/youtube"}}</a>
                                {{/if}}
                                {{#if instagram}}
                                <a class="social-link" href="{{social_url type="instagram"}}" target="_blank"
                                    rel="noopener">{{> "icons/instagram"}}</a>
                                {{/if}}
                            </div>
                        </div>
                    </div>
                    {{#if location}}
                    <div class="author-card-footer p-4 border-t border-border-light text-center">
                        <h6 class="author-profile-location flex items-center justify-center gap-1">
                            <svg width="18" height="18" viewBox="0 0 18 18" fill="none"
                                xmlns="http://www.w3.org/2000/svg">
                                <g>
                                    <path
                                        d="M9 8.4375C10.1631 8.4375 11.1094 7.49123 11.1094 6.32812C11.1094 5.16502 10.1631 4.21875 9 4.21875C7.83689 4.21875 6.89062 5.16502 6.89062 6.32812C6.89062 7.49123 7.83689 8.4375 9 8.4375ZM9 5.625C9.3877 5.625 9.70312 5.94042 9.70312 6.32812C9.70312 6.71583 9.3877 7.03125 9 7.03125C8.6123 7.03125 8.29688 6.71583 8.29688 6.32812C8.29688 5.94042 8.6123 5.625 9 5.625Z"
                                        fill="currentColor" />
                                    <path
                                        d="M15.3281 6.32812C15.3281 2.8388 12.4893 0 9 0C5.51067 0 2.67188 2.8388 2.67188 6.32812C2.67188 7.70854 3.10859 9.02043 3.93483 10.122L7.31187 14.6243C7.70854 15.1531 8.33962 15.4688 9 15.4688C9.66038 15.4688 10.2915 15.1531 10.6882 14.6243L14.0652 10.122C14.8914 9.02043 15.3281 7.70854 15.3281 6.32812ZM12.9402 9.27816L9.56324 13.7804C9.42873 13.9597 9.22345 14.0625 9 14.0625C8.77655 14.0625 8.57127 13.9597 8.4368 13.7805L5.05979 9.27816C4.41759 8.42196 4.07812 7.40183 4.07812 6.32812C4.07812 3.6142 6.28608 1.40625 9 1.40625C11.7139 1.40625 13.9219 3.6142 13.9219 6.32812C13.9219 7.40183 13.5824 8.42196 12.9402 9.27816Z"
                                        fill="currentColor" />
                                    <path
                                        d="M12.5156 17.2969C12.5156 16.9085 12.2008 16.5938 11.8125 16.5938H6.1875C5.79916 16.5938 5.48438 16.9085 5.48438 17.2969C5.48438 17.6852 5.79916 18 6.1875 18H11.8125C12.2008 18 12.5156 17.6852 12.5156 17.2969Z"
                                        fill="currentColor" />
                                </g>
                            </svg>

                            {{location}}
                        </h6>
                    </div>
                    {{/if}}
                </div>
                {{/author}}
                <div class="authors-posts-list">
                    <div class="grid grid-cols-1 gap-4 md:gap-8 xl:gap-4 lg:grid-cols-2 xl:grid-cols-3">
                        {{#foreach posts}}
                        {{> "post-card"}}
                        {{/foreach}}
                    </div>
                    {{pagination}}
                </div>
            </div>




    </section>
    </main>