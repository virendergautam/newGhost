{{!< default}} {{#page}} <main id="site-main" class="site-main">
	<section class="contact-page py-[40px] md:py-[60px] lg:py-[70px]">
		<div class="container">
			{{!-- Header --}}
			<div class="text-center mb-8 sm:mb-10 md:mb-12 max-w-[340px] sm:max-w-[500px] lg:max-w-[800px] mx-auto">
				<h1 class="text-3xl md:text-4xl mb-3">{{title}}</h1>
				<p class="text-sm md:text-base"> {{excerpt}} </p>
			</div>
			{{#if @custom.contact_form_endpoint}}
			<div class="grid grid-cols-1 {{#if feature_image}}
				md:grid-cols-2
			{{else}}
				{{#if @site.cover_image}}
					md:grid-cols-2
				{{else}}
					md:grid-cols-1
				{{/if}}
					{{/if}} gap-5 max-w-[1250px] mx-auto">
				{{!-- Form Column --}}
				<div class="bg-alternate w-full max-w-[650px] mx-auto rounded-[20px] px-5 py-5 md:py-8 md:px-7 lg:py-12">
					<form class="flex flex-col gap-7 h-full" id="contact-form"
						action="{{@custom.contact_form_endpoint}}" method="POST">
						<div class="flex flex-col gap-1.5">
							<label for="contact-name" class="text-sm text-heading">Full Name<span>*</span></label>
							<input type="text" id="contact-name" name="name" placeholder="Enter your full name" required
								class="rounded-lg px-3.5 min-h-[50px] border border-transparent text-sm text-text bg-main/50 outline-none transition-all duration-200 font-[inherit] resize-none placeholder:text-text/70 focus:border-accent" />
						</div>

						<div class="flex flex-col gap-1.5">
							<label for="contact-name" class="text-sm text-heading">Email<span>*</span></label>
							<input type="email" id="contact-email" name="email" placeholder="Example@gmail.com" required
								class="rounded-lg px-3.5 min-h-[50px] border border-transparent text-sm text-text bg-main/50 outline-none transition-all duration-200 font-[inherit] resize-none placeholder:text-text/70 focus:border-accent" />
						</div>

						<div class="flex flex-col gap-1.5">
							<label for="contact-name" class="text-sm text-heading"> Message<span>*</span></label>
							<textarea id="contact-message" name="message" placeholder="Enter your message here" rows="5"
								required
								class="rounded-lg px-3.5 py-[10px] min-h-[50px] border border-transparent text-sm text-text bg-main/50 outline-none transition-all duration-200 font-[inherit] resize-none placeholder:text-text/70 focus:border-accent"></textarea>
						</div>

						<button type="submit" id="contact-submit" class="w-full button button-large contact-button">
							<span class="btn-text">Send Message</span>
							<span class="btn-loading hidden">Sending…</span>
						</button>

					</form>
				</div>
				{{!-- Image Column — uses the page's Feature Image --}}
				{{#if feature_image}}
				<div
					class="relative min-h-[350px] h-full max-w-[650px] rounded-[20px] flex items-center justify-center bg-alternate text-center text-text/300 overflow-hidden">
					<img src="{{feature_image}}"
						alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}Contact{{/if}}"
						class="w-full h-full object-cover block absolute inset-0" />
				</div>
				{{else if @site.cover_image}}
				<div
					class="relative h-full rounded-[20px] flex items-center justify-center bg-alternate text-center text-text/300 overflow-hidden">
					<img src="{{@site.cover_image}}" alt="{{@site.title}}"
						class="w-full h-full object-cover block absolute inset-0" />
				</div>
				{{/if}}
			</div>
			{{else}}
			<div class="contact-details pt-5 text-center max-w-[800px] mx-auto">
				{{content}}
			</div>
			{{/if}}
		</div>
	</section>

	</main>
	{{/page}}
<script>
document.addEventListener("DOMContentLoaded", function () {

  const form = document.getElementById('contact-form');
  const button = document.getElementById('contact-submit');

  form.addEventListener('submit', function (e) {

    // 🔥 Check if form is valid
    if (!form.checkValidity()) {
      return; // ❌ Do nothing if invalid
    }

    // ✅ Valid → change button state
    button.querySelector('.btn-text').classList.add('hidden');
    button.querySelector('.btn-loading').classList.remove('hidden');
  });

});
</script>