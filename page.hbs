{{!< default}} {{!-- The tag above means: insert everything in this file into the {body} tag of the default.hbs template
    --}} {{#post}} {{!-- Everything inside the #post block pulls data from the page --}} <main id="site-main"
    class="site-main outer">
    <section class="{{post_class}} py-[70px]">
        <div class="container">
            {{#match @page.show_title_and_feature_image}}
            <header class="page-header gh-canvas grid gap-5 mb-8">
                {{#if feature_image}}
                <figure class="page-image">
                    {{!-- This is a responsive image, it loads different sizes depending on device
                    https://medium.freecodecamp.org/a-guide-to-responsive-images-with-ready-to-use-templates-c400bd65c433
                    --}}
                    <img class="block w-full" srcset="{{img_url feature_image size=" s"}} 300w, {{img_url feature_image size="m" }} 600w,
                        {{img_url feature_image size="l" }} 1000w, {{img_url feature_image size="xl" }} 2000w"
                        sizes="(min-width: 1400px) 1400px, 92vw" src="{{img_url feature_image size=" xl"}}"
                        alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}" />
                    {{#if feature_image_caption}}
                    <figcaption class="text-center">{{feature_image_caption}}</figcaption>
                    {{/if}}
                </figure>
                {{/if}}
               {{#match title "(Untitled)"}}
                {{!-- Do nothing (hide it) --}}
                {{else}}
                <h1>{{title}}</h1>
                {{/match}}
            </header>
            {{/match}}
            <div class="gh-content kg-canvas ">
                {{content}}
            </div>
        </div>
    </section>
    </main>

    {{/post}}