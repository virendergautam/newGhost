{{!< default}} {{#post}} <main id="site-main" class="site-main outer">
    <section class="py-[40px] md:py-[60px] lg:py-[70px]">
        <div class="container">
            <div class="text-center mb-7">
                <h2 class="text-3xl md:text-4xl lg:text-5xl">{{title}}</h2>
            </div>
            {{#get "authors" limit="100" include="count.posts"}}
            <div id="authors-container" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6 gap-x-5 gap-y-7 lg:gap-x-8 lg:gap-y-10">
                {{#foreach authors}}
                <div class="author-item">
                    {{> "author-card"}}
                </div>
                {{/foreach}}
            </div>
            <div class="text-center mt-10 justify-center">
                <button id="loadMoreAuthors" class="show-more-btn button">
                    <span class="button-text relative overflow-hidden">
                        <span class="button-text-inner top-text">{{t "Show more"}}</span>
                        <span class="button-text-inner bottom-text">{{t "Show more"}}</span>
                    </span>
                </button>
            </div>

            {{/get}}
        </div>
    </section>
    </main>
    {{/post}}