{{!< default}}
{{#post}} 
<main id="site-main" class="site-main outer">
    <section class="py-[70px]">
        <div class="container">
            <div class="text-center mb-7">
                <h2 class="text-2xl md:text-3xl lg:text-5xl">{{title}}</h2>
            </div>
            {{#get "authors" limit="100" include="count.posts"}}
            <div class="grid grid-cols-2 lg:grid-cols-6 gap-x-8 gap-y-10">
                {{#foreach authors}}
                {{> "author-card"}}
                {{/foreach}}
            </div>
            {{/get}}
        </div>
    </section>
</main>
{{/post}}