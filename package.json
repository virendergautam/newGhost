{
  "name": "your-theme-name",
  "description": "Your custom Ghost theme",
  "version": "1.0.0",
  "engines": {
    "ghost": ">=5.0.0"
  },
  "license": "MIT",
  "scripts": {
    "dev": "tailwindcss -i ./assets/css/main.css -o ./assets/built/main.css --watch",
    "build": "tailwindcss -i ./assets/css/main.css -o ./assets/built/main.css --minify",
    "test": "gscan ."
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.17",
    "tailwindcss": "^4.1.17",
    "gscan": "^5.2.4"
  },
  "config": {
    "custom": {
      "number_of_featured_posts": {
        "type": "text",
        "default": "3",
        "group": "homepage"
      },
      "home_feed_title": {
        "type": "text",
        "default": "New Article",
        "group": "homepage"
      },
      "home_feed_tags": {
        "type": "text",
        "default": "",
        "description": "Enter the tag slug to show posts, separate by comma. Example: Fashion,lifestyle,travel",
        "group": "homepage"
      },
      "feed_card_layout": {
        "type": "select",
        "options": [
          "Heading first",
          "Image first"
        ],
        "default": "Heading first",
        "group": "homepage"
      },
      "feed_image_orientation": {
        "type": "select",
        "options": [
          "Landscape",
          "Potrait",
          "Square",
          "Free"
        ],
        "default": "Landscape",
        "group": "homepage"
      },
      "home_tags_section": {
        "type": "text",
        "default": "",
        "group": "homepage"
      },
      "category_title": {
        "type": "text",
        "default": "Read by Category",
        "description": "Enter the tag slug to show posts, separate by comma. Example: Fashion,lifestyle,travel",
        "group": "homepage"
      }
    }
  }
}
