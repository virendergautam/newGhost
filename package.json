{
  "name": "gravity",
  "version": "1.0.0",
  "engines": {
    "ghost": ">=5.0.0"
  },
  "license": "MIT",
  "scripts": {
    "dev": "tailwindcss -i ./assets/css/main.css -o ./assets/built/main.css --watch",
    "build": "tailwindcss -i ./assets/css/main.css -o ./assets/built/main.css --minify",
    "test": "gscan ."
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.17",
    "tailwindcss": "^4.1.17",
    "gscan": "^5.2.4"
  },
  "keywords": [
    "ghost-theme",
    "blog",
    "magazine"
  ],
  "author": {
    "name": "vikas",
    "email": "vikas.shinedezign@gmail.com"
  },
  "config": {
    "posts_per_page": 12,
    "custom": {
      "dark_mode_logo": {
        "type": "image",
        "default": ""
      },
      "appearance": {
        "type": "select",
        "options": [
          "Light",
          "Dark",
          "User defined"
        ],
        "default": "Light",
        "description": "Allow users to toggle between light and dark mode with their preference saved"
      },
      "header_layout": {
        "type": "select",
        "options": [
          "Fullwidth",
          "Sticky fullwidth",
          "Fixed layout",
          "Sticky fixed layout"
        ],
        "default": "Sticky fixed layout"
      },
      "social_links": {
        "type": "text",
        "default": "",
        "description": "Enter the social media URL, separate by comma."
      },
      "footer_copyright_text": {
        "type": "text",
        "default": "Copyright © 2024 Your Company. All rights reserved."
      },
      "number_of_featured_posts": {
        "type": "text",
        "default": "3",
        "group": "homepage"
      },
      "home_feed_title": {
        "type": "text",
        "default": "New Article",
        "group": "homepage"
      },
      "home_feed_tags": {
        "type": "text",
        "default": "",
        "description": "Enter the tag slug to show posts, separate by comma. Example: Fashion,lifestyle,travel",
        "group": "homepage"
      },
      "feed_image_orientation": {
        "type": "select",
        "options": [
          "Landscape",
          "Portrait",
          "Square",
          "Free"
        ],
        "default": "Landscape",
        "group": "homepage"
      },
      "home_tags_section": {
        "type": "text",
        "default": "",
        "group": "homepage",
        "description": "Enter the tag slug to show posts, separate by comma. Example: Fashion,lifestyle,travel"
      },
      "category_title": {
        "type": "text",
        "default": "Read by Category",
        "group": "homepage"
      },
      "banner_heading": {
        "type": "text",
        "default": "Thoughts on code, design, and the future of the web.",
        "group": "homepage"
      },
      "banner_description": {
        "type": "text",
        "default": "Join a community of over 10,000+ subscribers who receive curated links, exclusive tutorials, and honest advice on mastering the creator economy.",
        "group": "homepage"
      },
      "banner_background_image": {
        "type": "image",
        "default": "",
        "group": "homepage"
      },
      "footer_marquee_text": {
        "type": "text",
        "default": "Latest Topics, updates, and insights from our team.",
        "group": "homepage"
      },
      "post_layout": {
        "type": "select",
        "options": [
          "Default",
          "Wide image",
          "No image",
          "Full image",
          "Split image",
          "Gallery",
          "Sticky content",
          "Images slider"
        ],
        "default": "Default",
        "group": "post"
      },
      "contact_form_endpoint": {
        "type": "text",
        "default": "",
        "description": "Endpoint URL for the contact form, such as a Formspree endpoint.Example:https://formspree.io/f/yourformid"
      }
    }
  }
}
