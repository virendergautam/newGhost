{
  "name": "your-theme-name",
  "description": "Your custom Ghost theme",
  "version": "1.0.0",
  "engines": {
    "ghost": ">=5.0.0"
  },
  "license": "MIT",
  "scripts": {
    "dev": "tailwindcss -i ./assets/css/main.css -o ./assets/built/main.css --watch",
    "build": "tailwindcss -i ./assets/css/main.css -o ./assets/built/main.css --minify",
    "test": "gscan ."
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.17",
    "tailwindcss": "^4.1.17",
    "gscan": "^5.2.4"
  },
  "config": {
    "custom": {
      "appearance": {
        "type": "select",
        "options": [
          "Light",
          "Dark",
          "User defined"
        ],
        "default": "Light",
        "description": "Allow users to toggle between light and dark mode with their preference saved"
      },
      "header_layout": {
        "type": "select",
        "options": [
          "Full width",
          "sticky with full width",
          "Fixed layout",
          "sticky with fixed layout"
        ],
        "default": "Full width"
      },
      "social_links": {
        "type": "text",
        "default": "",
        "description": "Enter the social media name and URL, separate by comma. Example:https://facebook.com/yourpage,https://twitter.com/yourpage"
      },
      "footer_copyright_text": {
        "type": "text",
        "default": "Copyright © 2024 Your Company. All rights reserved."
      },
      "number_of_featured_posts": {
        "type": "text",
        "default": "3",
        "group": "homepage"
      },
      "home_feed_title": {
        "type": "text",
        "default": "New Article",
        "group": "homepage"
      },
      "home_feed_tags": {
        "type": "text",
        "default": "",
        "description": "Enter the tag slug to show posts, separate by comma. Example: Fashion,lifestyle,travel",
        "group": "homepage"
      },
      "feed_card_layout": {
        "type": "select",
        "options": [
          "Heading first",
          "Image first"
        ],
        "default": "Heading first",
        "group": "homepage"
      },
      "feed_image_orientation": {
        "type": "select",
        "options": [
          "Landscape",
          "Potrait",
          "Square",
          "Free"
        ],
        "default": "Landscape",
        "group": "homepage"
      },
      "home_tags_section": {
        "type": "text",
        "default": "",
        "group": "homepage",
        "description": "Enter the tag slug to show posts, separate by comma. Example: Fashion,lifestyle,travel"
      },
      "category_title": {
        "type": "text",
        "default": "Read by Category",
        "group": "homepage"
      },
      "hero_actions": {
        "type": "select",
        "options": [
          "Subscription form",
          "Social links",
          "None"
        ],
        "default": "Subscription form",
        "group": "homepage",
        "description": "Subscription form will be hidden if the Portal is disabled or set to invite-only."
      },
      "banner_background_image": {
        "type": "image",
        "default": "",
        "group": "homepage"
      }
    }
  }
}
