{{!< default}} 
{{#post}}
 <main id="site-main" class="site-main outer">
  <article class="blog-article post-detail py-[40px] md:py-[50px] lg:py-[70px]">
      {{#match @custom.post_layout "Images slider"}}
      {{> "postLayouts/postImagesSlider"}}
      {{else match @custom.post_layout "Wide image"}}
      {{> "postLayouts/widePost"}}
      {{else match @custom.post_layout "Full image"}}
      {{> "postLayouts/fullWidthImagePost"}}
        {{else match @custom.post_layout "Split image"}}
      {{> "postLayouts/splitPost"}}
        {{else match @custom.post_layout "Sticky content"}}
      {{> "postLayouts/stickyPost"}}
         {{else match @custom.post_layout "Gallery"}}
      {{> "postLayouts/postGallery"}}
      {{else}}
      {{> "postLayouts/defaultPost"}}
      {{/match}}
  </article>
    {{> "postContent/relatedPost"}}
  </main>

  {{/post}}