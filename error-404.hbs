{{!< default}} {{!-- There are two error files in this theme, one for 404s and one for all other errors. This file is
    the former, and handles all 404 Page Not Found errors. The 404 error is the most common error that a visitor might
    see, for example when following a broken link Keep this template as lightweight as you can! --}} <main
    id="site-main" class="site-main outer">
    <section class="error-content py-[70px]">
        <div class="container">
            <div class="error-message text-center min-h-[500px] flex flex-col justify-center items-center">
                <h1 class="error-code text-4xl md:text-6xl mb-3">{{message}}</h1>
                <p class="error-description text-lg mb-5">{{t "The page you were looking for doesn't exist."}}</p>
                <a class="error-link button button-large" href="{{@site.url}}">{{t "Go to the Homepage"}}</a>
            </div>
            {{!-- Given that people landing on this page didn't find what they
            were looking for, let's give them some alternative stuff to read. --}}
            <div class="mt-5">
                <h2 class="text-xl md:text-2xl mb-5">{{t "You may also like"}}</h2>
                <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                    {{#get "posts" include="authors" limit="4" as |more_posts|}}
                    {{#if more_posts}}
                    {{#foreach more_posts}}
                    {{> "post-card"}}
                    {{/foreach}}
                    {{/if}}
                    {{/get}}
                </div>
            </div>
        </div>
    </section>
    </main>