                        class="relative w-[150px] md:w-[200px] aspect-square rounded-lg overflow-hidden border-[2px] border-alternate text-text/20 flex items-center justify-center relative z-2">
                        {{#with posts.[0]}}
                        {{#if feature_image}}
                        <img src="{{img_url feature_image}}" class="w-full h-full object-cover">
