        <div class="container relative text-center">
            <div class="max-w-[800px] mx-auto">
                {{!-- Overlapping Images Design --}}
                {{#get "posts" limit="3" filter="tag:hash-custom" include="tags"}}
                <div class="flex items-center justify-center mb-12 pointer-events-none md:pointer-events-auto">

                    {{!-- CASE: 3 POSTS --}}
