{{!< default}}
{{!-- The tag above means: insert everything in this file
into the {body} of the default.hbs template --}}


<main id="site-main" class="site-main outer">
{{!-- Featured Slider Section --}}
{{#get "posts" limit="5" include="tags,authors" as |featured|}}
    {{#if featured}}
        <section class="featured-slider py-[50px] border-be border-[#E5E7EB] bg-[#F3F4F6]">
            <div class="container">
                <div class="main-swiper swiper overflow-hidden relative">
                    <div class="swiper-wrapper">
                        {{#foreach featured}}
                            <div class="swiper-slide !h-auto flex flex-col justify-center">
                                {{!-- Main Content Wrapper: Groups Text and Image --}}
                                <div class="featured-slider-card h-full grid grid-cols-1 lg:grid-cols-[1fr_1.4fr] gap-12">
                                    {{!-- Text Content --}}
                                    <div class="slide-content space-y-6">
                                        <div class="flex items-center gap-4">
                                            <div class="flex gap-2">
                                                {{#foreach tags limit="2"}}
                                                    <span class="px-5 py-1.5 bg-white rounded-lg text-xs border">{{name}}</span>
                                                {{/foreach}}
                                            </div>
                                            <span class="text-xs font-medium">{{reading_time}}</span>
                                        </div>

                                        <h2 class="text-5xl">
                                            <a href="{{url}}">{{title}}</a>
                                        </h2>

                                        <p class="text-sm line-clamp-3 max-w-xl">
                                            {{excerpt}}
                                        </p>

                                        {{#foreach authors}}
                                            <div class="flex items-center gap-3">
                                                {{#if profile_image}}
                                                    <img src="{{img_url profile_image size="xs"}}" alt="{{name}}" class="w-12 h-12 rounded-full object-cover shadow-md">
                                                {{/if}}
                                                <div>
                                                    <div class="font-bold text-gray-900 leading-none">{{name}}</div>
                                                    <div class="text-xs text-gray-400 mt-1">Published on {{date format="DD MMM YYYY"}}</div>
                                                </div>
                                            </div>
                                        {{/foreach}}
                                    </div>

                                    {{!-- Right Large Image --}}
                                    <div class="relative bg-gray-200 min-h-[650px] h-full rounded-[20px] overflow-hidden flex items-center justify-center">
                                        {{#if feature_image}}
                                            <img src="{{img_url feature_image size="l"}}" alt="{{title}}" class="w-full h-full object-cover">
                                        {{else}}
                                            <span class="text-gray-400">Featured Image Not Set</span>
                                        {{/if}}
                                    </div>
                                </div>
                            </div>
                        {{/foreach}}
                    </div>
                    <div class="navigation-wrapper absolute z-1 bottom-[40px] left-0 w-full max-w-[56%] flex items-end justify-between gap-12 p-[10px] bg-[#F3F4F6] rounded-lg">
                        <div class="flex items-center gap-5">
                            <div class="flex gap-2">
                                <button class="swiper-button-prev-custom w-12 h-12 rounded-full flex items-center justify-center bg-white hover:bg-gray-50 transition-all shadow-sm border border-gray-100 cursor-pointer">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
                                </button>
                                <button class="swiper-button-next-custom w-12 h-12 rounded-full flex items-center justify-center bg-white hover:bg-gray-50 transition-all shadow-sm border border-gray-100 cursor-pointer">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                                </button>
                            </div>
                            <div class="swiper-pagination-custom text-gray-400 font-medium min-w-[40px]">
                                <span class="active-index text-gray-900">1</span>/{{featured.length}}
                            </div>
                        </div>

                        {{!-- Thumbnail Slider relocated here --}}
                        <div class="thumbs-swiper swiper max-w-sm !mx-0">
                            <div class="swiper-wrapper gap-2.5">
                                {{#foreach featured}}
                                    <div class="swiper-slide !w-auto">
                                        <div class="thumb-card w-[130px] xl:w-[180px] aspect-4/3 bg-gray-200 rounded-lg overflow-hidden transition-all cursor-pointer">
                                            {{#if feature_image}}
                                                <img src="{{img_url feature_image size="s"}}" alt="{{title}}" class="rounded-lg w-full h-full object-cover">
                                            {{else}}
                                                 <div class="w-full h-full flex items-center justify-center">
                                                     <span class="">No Img</span>
                                                 </div>
                                            {{/if}}
                                        </div>
                                    </div>
                                {{/foreach}}
                            </div>
                        </div>
                    </div>
                    </div>
                </div>
            </div>
        </section>
        {{/if}}
    {{/get}}

    {{!-- New Articles Section --}}
    <section class="new-articles py-24 bg-[#F3F4F6] border-t border-gray-100">
        <div class="max-w-[1580px] mx-auto px-6">
            {{!-- Section Header --}}
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-12 gap-6">
                <h2 class="text-4xl md:text-5xl font-bold text-gray-900 tracking-tight">New Articles</h2>
                <div class="flex flex-wrap items-center gap-3">
                    <button class="px-6 py-2.5 bg-[#4CAF50] text-white rounded-full text-sm font-semibold shadow-md border-2 border-[#4CAF50] hover:opacity-90 transition-all">All</button>
                    <button class="px-6 py-2.5 bg-white text-gray-400 rounded-full text-sm font-semibold border-2 border-gray-100 hover:border-gray-200 transition-all">Popular</button>
                    <button class="px-6 py-2.5 bg-white text-gray-400 rounded-full text-sm font-semibold border-2 border-gray-100 hover:border-gray-200 transition-all">Trending</button>
                    <button class="px-6 py-2.5 bg-white text-gray-400 rounded-full text-sm font-semibold border-2 border-gray-100 hover:border-gray-200 transition-all">Most Discussed</button>
                </div>
            </div>

            {{!-- Articles Grid --}}
            {{#get "posts" limit="8" include="tags,authors" order="published_at desc"}}
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
                {{#foreach posts}}
                <article class="article-card group bg-white rounded-[40px] p-8 shadow-sm hover:shadow-xl transition-all border border-gray-50 flex flex-col h-full">
                    {{!-- Category Tag --}}
                    <div class="mb-4">
                        {{#if primary_tag}}
                        <span class="px-4 py-1 bg-white border border-gray-100 text-[#6B7280] text-xs font-semibold rounded-lg shadow-sm">
                            {{primary_tag.name}}
                        </span>
                        {{/if}}
                    </div>

                    {{!-- Title --}}
                    <h3 class="text-xl md:text-2xl font-bold text-gray-900 mb-6 leading-tight line-clamp-2 h-[3.5rem] group-hover:text-blue-600 transition-colors">
                        <a href="{{url}}">{{title}}</a>
                    </h3>

                    {{!-- Featured Image --}}
                    <div class="relative aspect-[4/3] rounded-[32px] overflow-hidden mb-6 shadow-sm border-2 border-white">
                        {{#if feature_image}}
                        <img src="{{img_url feature_image size="m"}}" alt="{{title}}" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110">
                        {{else}}
                        <div class="w-full h-full bg-gray-100 flex items-center justify-center">
                            <span class="text-gray-400 font-bold">NO IMAGE</span>
                        </div>
                        {{/if}}
                    </div>

                    {{!-- Excerpt --}}
                    <p class="text-[15px] text-[#6B7280] leading-relaxed line-clamp-3 mb-8">
                        {{excerpt}}
                    </p>

                    {{!-- Footer Metadata --}}
                    <div class="mt-auto pt-6 border-t border-gray-50 flex items-center justify-between">
                        <div class="flex items-center gap-2 text-[#9CA3AF] text-sm">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                            <span>{{date format="MMM DD, YYYY"}}</span>
                        </div>
                        
                        {{#foreach authors}}
                        <div class="flex items-center gap-2.5">
                            <span class="text-xs font-bold text-gray-900">By {{name}}</span>
                            {{#if profile_image}}
                            <img src="{{img_url profile_image size="xs"}}" alt="{{name}}" class="w-8 h-8 rounded-full border border-white shadow-sm object-cover">
                            {{/if}}
                        </div>
                        {{/foreach}}
                    </div>
                </article>
                {{/foreach}}
            </div>

            {{!-- View All Button --}}
            <div class="mt-16 flex justify-center">
                <a href="/archive" class="px-8 py-3.5 bg-white text-gray-900 font-bold text-sm rounded-xl border border-gray-200 shadow-sm hover:bg-gray-50 transition-all">View All</a>
            </div>
            {{/get}}
        </div>
    </section>

    <script>
    document.addEventListener('DOMContentLoaded', function() {
        const thumbsSwiper = new Swiper(".thumbs-swiper", {
            slidesPerView: "auto",
            freeMode: true,
            watchSlidesVisibility: true,
            watchSlidesProgress: true,
        });

        const mainSwiper = new Swiper(".main-swiper", {
            spaceBetween: 10,
            effect: 'fade',
            fadeEffect: {
                crossFade: true
            },
            thumbs: {
                swiper: thumbsSwiper,
            },
            navigation: {
                nextEl: ".swiper-button-next-custom",
                prevEl: ".swiper-button-prev-custom",
            },
            on: {
                slideChange: function () {
                    const activeIndex = this.realIndex + 1;
                    document.querySelector('.active-index').textContent = activeIndex;
                }
            }
        });
    });
    </script>
</main>
