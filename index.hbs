{{!< default}} {{!-- The tag above means: insert everything in this file into the {body} of the default.hbs template
    --}} <main id="site-main" class="site-main outer">

    {{!-- Featured Slider Section --}}
    {{#get "posts" limit=@custom.number_of_featured_posts include="tags,authors" filter="featured:true" as |featured|}}
    {{#if featured}}
    <section class="featured-slider py-[50px] border-be border-[#E5E7EB] bg-[#E7E8E9]">
        <div class="container">
            <div class="main-swiper swiper overflow-hidden relative">
                <div class="swiper-wrapper">
                    {{#foreach featured}}
                    <div class="swiper-slide flex flex-col justify-center">
                        {{!-- Main Content Wrapper: Groups Text and Image --}}
                        <div class="featured-slider-card h-full grid grid-cols-1 lg:grid-cols-[1fr_1.4fr] gap-12">
                            {{!-- Text Content --}}
                            <div class="slide-content space-y-6">
                                <div class="flex items-center gap-4">
                                    {{#if tags.[0]}}

                                    <div class="flex gap-2">
                                        {{#foreach tags}}
                                        <span
                                            class="px-4 py-1 min-h-[20px] flex items-center bg-white rounded-sm text-xs border">{{name}}</span>
                                        {{/foreach}}
                                    </div>
                                    {{/if}}
                                    <span class="text-xs font-medium">{{reading_time}}</span>
                                </div>

                                <h2 class="text-5xl">
                                    <a href="{{url}}">{{title}}</a>
                                </h2>

                                <p class="text-sm line-clamp-3 max-w-xl">
                                    {{excerpt}}
                                </p>

                                {{#foreach authors}}
                                <div class="flex items-center gap-3">
                                    {{#if profile_image}}
                                    <img src="{{img_url profile_image size=" xs"}}" alt="{{name}}"
                                        class="w-12 h-12 rounded-full object-cover shadow-md">
                                    {{/if}}
                                    <div>
                                        <div class="font-bold text-gray-900 leading-none">{{name}}</div>
                                        <div class="text-xs text-gray-400 mt-1">Published on {{date format="DD MMM
                                            YYYY"}}</div>
                                    </div>
                                </div>
                                {{/foreach}}
                            </div>

                            {{!-- Right Large Image --}}
                            <div
                                class="relative bg-[#F3F4F6] text-[#dbdbdb] h-[690px] rounded-[20px] overflow-hidden flex items-center justify-center">
                                {{#if feature_image}}
                                <img src="{{img_url feature_image size=" l"}}" alt="{{title}}"
                                    class="w-full h-full object-cover">
                                {{else}}
                                <span>NO IMAGE</span>
                                {{/if}}
                                <a href="{{url}}"></a>
                            </div>
                        </div>
                    </div>
                    {{/foreach}}
                </div>
                {{#if featured.[1]}}
                <div
                    class="navigation-wrapper absolute z-1 bottom-[40px] left-0 w-full max-w-[56%] flex items-end justify-between gap-12 p-[10px] bg-[##E7E8E9] rounded-lg">
                    <div class="flex items-center gap-5">
                        <div class="flex gap-2">
                            <button
                                class="swiper-button-prev-custom w-12 h-12 rounded-full flex items-center justify-center bg-white hover:bg-gray-50 transition-all shadow-sm border border-gray-100 cursor-pointer">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                                    fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                    stroke-linejoin="round">
                                    <path d="m15 18-6-6 6-6" />
                                </svg>
                            </button>
                            <button
                                class="swiper-button-next-custom w-12 h-12 rounded-full flex items-center justify-center bg-white hover:bg-gray-50 transition-all shadow-sm border border-gray-100 cursor-pointer">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                                    fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                    stroke-linejoin="round">
                                    <path d="m9 18 6-6-6-6" />
                                </svg>
                            </button>
                        </div>
                        <div class="swiper-pagination-custom text-gray-400 font-medium min-w-[40px]">
                            <span class="active-index text-gray-900">1</span>/{{featured.length}}
                        </div>
                    </div>

                    {{!-- Thumbnail Slider relocated here --}}
                    <div class="thumbs-swiper swiper max-w-sm !mx-0">
                        <div class="swiper-wrapper gap-2.5">
                            {{#foreach featured}}
                            <div class="swiper-slide !w-auto">
                                <div
                                    class="thumb-card w-[130px] xl:w-[180px] aspect-4/3 bg-[#F3F4F6] text-[#dbdbdb] rounded-lg overflow-hidden transition-all cursor-pointer">
                                    {{#if feature_image}}
                                    <img src="{{img_url feature_image size=" s"}}" alt="{{title}}"
                                        class="rounded-lg w-full h-full object-cover">
                                    {{else}}
                                    <div class="w-full h-full flex items-center justify-center">
                                        <span class="">NO IMAGE</span>
                                    </div>
                                    {{/if}}
                                </div>
                            </div>
                            {{/foreach}}
                        </div>
                    </div>
                </div>
                {{/if}}

            </div>
        </div>
    </section>
    {{/if}}
    {{/get}}

    {{!-- All posts Section --}}

    <section class="py-[70px] bg-[#E7E8E9]">
        <div class="container">

            <!-- HEADER -->
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-[25px] gap-6">
                <h2 class="text-2xl md:text-3xl tracking-tight">{{@custom.home_feed_title}}</h2>

                <div class="flex flex-wrap items-center gap-3">
                    <button class="filter-tab-btn tab-btn active px-5 py-1.5 rounded-lg text-sm border" data-tab="all">
                        All
                    </button>

                    {{#get "tags" filter="slug:[{{@custom.home_feed_tags}}]"}}
                    {{#foreach tags}}
                    <button class="filter-tab-btn tab-btn px-5 py-1.5 rounded-lg text-sm border" data-tab="{{slug}}">
                        {{name}}
                    </button>
                    {{/foreach}}
                    {{/get}}
                </div>
            </div>

            <!-- CONTENT -->
            <div class="tab-content">

                <!-- ALL TAB -->
                <div id="tab-all" class="tab-grid">
                    {{#get "posts" limit="50" include="tags,authors" order="published_at desc"}}
                    <div class="posts-container grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                        {{#foreach posts}}
                        <div class="post-item hidden">
                            {{> post-card}}
                        </div>
                        {{/foreach}}
                    </div>

                    <div class="text-center mt-6">
                        <button class="show-more-btn px-6 py-2 border rounded">
                            Show More
                        </button>
                    </div>
                    {{/get}}
                </div>

                <!-- TAG TABS -->
                {{#get "tags" filter="slug:[{{@custom.home_feed_tags}}]"}}
                {{#foreach tags}}
                <div id="tab-{{slug}}" class="tab-grid hidden">
                    {{#get "posts" limit="50" include="tags,authors" filter="tag:{{slug}}" order="published_at desc"}}
                    <div class="posts-container grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                        {{#foreach posts}}
                        <div class="post-item hidden">
                            {{> post-card}}
                        </div>
                        {{/foreach}}
                    </div>

                    <div class="text-center mt-6">
                        <button class="show-more-btn px-6 py-2 border rounded">
                            Show More
                        </button>
                    </div>
                    {{/get}}
                </div>
                {{/foreach}}
                {{/get}}

            </div>
        </div>
    </section>


    {{!-- recommended post section --}}
    <section class="">
        {{#get "posts" limit="3" include="tags,authors" filter="tag:hash-recommended" order="published_at desc"}}
        <div class="flex overflow-hidden">
            {{#foreach posts}}
            <div
                class="group card relative min-h-[80dvh] flex items-center justify-center flex-1 hover:flex-[1.3] transition-all duration-400">
                <div
                    class="absolute inset-0 overflow-hidden bg-[#F3F4F6] text-[#dbdbdb] flex items-center justify-center w-[110vw]">
                    {{#if feature_image}}
                    <img src="{{img_url feature_image size=" m"}}" alt="{{title}}" class="w-full h-full object-cover" />
                    {{else}}
                    <span class="font-bold">NO IMAGE</span>
                    {{/if}}
                    {{!-- <img src="https://deigo.trexthemes.dev/content/images/2025/10/Rectangle-2.png" alt=""
                        class="w-full h-full object-cover"> --}}
                </div>
                <article id="article-card-{{@index}}"
                    class="relative z-1 article-card group flex flex-col w-full max-w-[460px] mx-auto opacity-0 group-hover:opacity-100 transition-all duration-400 ease">
                    <div id="article-card-iamge-{{@index}}"
                        class="border-16 border-white rounded-t-xl article-card-image aspect-[3/2]"> </div>
                    <div class="bg-white p-4 pb-[0px] rounded-b-xl">
                        {{! Category Tag }}
                        <div class="mb-4">
                            <div class="flex gap-2">
                                {{#foreach tags}}
                                <span
                                    class="px-4 py-1 min-h-[20px] flex items-center bg-white rounded-sm text-xs border">{{name}}</span>
                                {{/foreach}}
                            </div>
                        </div>

                        {{! Title }}
                        <h3
                            class="text-md md:text-xl mb-4 leading-tight line-clamp-2 group-hover:text-blue-600 transition-colors">
                            <a href="{{url}}">{{title}}</a>
                        </h3>

                        {{! Excerpt }}
                        <p class="leading-relaxed line-clamp-3 mb-5">
                            {{excerpt}}
                        </p>

                        {{! Footer Metadata }}
                        <div class="mt-auto py-[15px] border-t flex items-center justify-between">
                            {{#foreach authors}}
                            <div class="flex items-center gap-3">
                                {{#if profile_image}}
                                <img src="{{img_url profile_image size=" xs"}}" alt="{{name}}"
                                    class="w-10 h-10 rounded-full object-cover">
                                {{/if}}
                                <div>
                                    <div class="font-bold leading-none">{{name}}</div>
                                    <div class="text-xs mt-1">Published on {{date format="DD MMM YYYY"}}</div>
                                </div>
                            </div>
                            {{/foreach}}
                        </div>
                    </div>

                </article>
            </div>
            {{/foreach}}
        </div>
        {{/get}}
    </section>


    {{!-- Latest Posts Section with Dual-State Hover Effect --}}
    {{#if @custom.home_tags_section}}

    <section class="pbs-[70px] bg-[#E7E8E9]">
        <div class="container">
            <div class="bg-white rounded-[30px] p-[40px]">

                {{!-- PAGE BLOCK --}}
                {{#get "pages" filter="tag:hash-categories-posts" limit="1"}}
                {{#if pages}}
                {{#foreach pages}}
                <div class="text-center max-w-2xl mx-auto mb-10">
                    <h2 class="text-4xl md:text-5xl font-bold mb-4">{{title}}</h2>
                    {{#if excerpt}}
                    <p>{{excerpt}}</p>
                    {{/if}}
                </div>
                {{/foreach}}
                {{/if}}
                {{/get}}

                {{!-- TAGS BLOCK --}}
                {{#get "tags" filter="slug:[{{@custom.home_tags_section}}]"}}
                {{#if tags}}

                {{#foreach tags}}
                <section class="mb-12">

                    <h2 class="text-2xl font-bold mb-6">{{name}}</h2>

                    {{#get "posts" limit="4" include="tags,authors" filter="tag:{{slug}}" order="published_at desc"}}

                    {{#if posts}}
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
                        {{#foreach posts}}
                        <a href="{{url}}"
                            class="group relative flex flex-col bg-[#F3F7F7] rounded-[10px] overflow-hidden aspect-[3/4] cursor-pointer">

                            {{!-- Enhanced Image Expansion Layer --}}
                            <div
                                class="absolute inset-0 m-auto [clip-path:circle(25%_at_50%_45%)] group-hover:[clip-path:circle(100%_at_50%_50%)] overflow-hidden transition-all duration-700 ease-in-out">
                                {{#if feature_image}}
                                <img src="{{img_url feature_image size=" l"}}" alt="{{title}}"
                                    class="w-full h-full object-cover">
                                {{/if}}
                            </div>

                            {{!-- Normal State Content --}}
                            <div class="relative flex flex-col h-full justify-between px-[14px] py-[20px]">
                                <div class="flex gap-2">
                                    {{#foreach tags}}
                                    <span
                                        class="px-4 py-1 min-h-[20px] flex items-center bg-white rounded-sm text-xs border group-hover:text-white group-hover:bg-[#F4F4F433] group-hover:backdrop-blur-2xl transition-all ease-in">{{name}}</span>
                                    {{/foreach}}
                                </div>
                                <div class="w-full">
                                    <span
                                        class="text-xs font-medium mb-1 text-white opacity-0 group-hover:opacity-70 transition-all ease-in">{{date
                                        format="MMM DD, YYYY"}}</span>
                                    <h3 class="text-base font-bold group-hover:text-white transition-all ease-in">
                                        {{title}}
                                    </h3>
                                </div>
                            </div>
                        </a>
                        {{/foreach}}
                    </div>
                    {{else}}
                    <div class="py-10 text-center text-gray-400">
                        No posts found in {{name}}
                    </div>
                    {{/if}}

                    {{/get}}

                </section>
                {{/foreach}}

                {{/if}}
                {{/get}}

            </div>
        </div>
    </section>

    {{/if}}


    {{!-- Read by Category Section --}}
    <section class="pbs-[70px] bg-[#E7E8E9]">
        <div class="container">
            <div class="flex items-center justify-between mb-[25px]">
                <h2 class="text-2xl md:text-3xl font-bold tracking-tight">{{@custom.category_title}}</h2>
            </div>
            {{#get "tags" limit="all" include="count.posts" order="count.posts desc"}}
            <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-6">
                {{#foreach tags}}
                <a href="{{url}}" class="group flex flex-col gap-3">
                    <div
                        class="relative aspect-square bg-[#F3F4F6] text-[#dbdbdb] flex items-center justify-center rounded-lg overflow-hidden">
                        {{#if feature_image}}
                        <img src="{{img_url feature_image size=" s"}}" alt="{{name}}"
                            class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500 ease-in-out">
                        {{else}}
                        <span class="font-bold">NO IMAGE</span>
                        {{/if}}
                        <div
                            class="absolute inset-0 bg-black/5 opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none">
                        </div>
                    </div>
                    <div class="flex flex-col">
                        <h3 class="text-base leading-tight">{{name}}</h3>
                        <span class="text-xs mt-1.5">{{count.posts}} articles</span>
                    </div>
                </a>
                {{/foreach}}
            </div>
            {{/get}}
        </div>
    </section>


    {{!-- Newsletter Hero Section --}}
    <section class="py-[70px] bg-[#E7E8E9] relative overflow-hidden" {{#if @custom.banner_background_image}}
        style="background-image: url('{{img_url @custom.banner_background_image}}');" {{/if}}>
        {{!-- Wavy Background Element --}}
        <div class="absolute inset-0 z-0 pointer-events-none opacity-40">
            <svg viewBox="0 0 1440 600" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full opacity-30">
                <path d="M0 250C320 350 480 150 720 250C960 350 1120 150 1440 250V600H0V250Z"
                    fill="url(#hero-gradient)" />
                <defs>
                    <linearGradient id="hero-gradient" x1="720" y1="200" x2="720" y2="600"
                        gradientUnits="userSpaceOnUse">
                        <stop stop-color="#F5F3FF" />
                        <stop offset="1" stop-color="white" />
                    </linearGradient>
                </defs>
            </svg>
        </div>

        <div class="container relative text-center ">
            {{!-- Overlapping Images Design --}}
            {{#get "posts" limit="3" filter="tag:hash-custom" include="tags"}}
            {{log posts "jhghjghhjhj"}}
            <div class="flex items-center justify-center mb-12 select-none pointer-events-none md:pointer-events-auto">

                {{!-- CASE: 3 POSTS --}}
                {{#match posts.length ">=" 3}}

                <!-- LEFT -->
                <div
                    class="w-[100px] md:w-[150px] aspect-square rounded-lg overflow-hidden border-[2px] border-white -rotate-[15deg] translate-x-[25px] translate-y-[10px]">
                    {{#with posts.[0]}}
                    {{#if feature_image}}
                    <img src="{{img_url feature_image}}" class="w-full h-full object-cover">
                    {{/if}}
                    {{/with}}
                </div>

                <!-- CENTER -->
                <div class="w-[150px] md:w-[200px] aspect-square rounded-lg overflow-hidden border-[2px] border-white">
                    {{#with posts.[1]}}
                    {{#if feature_image}}
                    <img src="{{img_url feature_image}}" class="w-full h-full object-cover">
                    {{/if}}
                    {{/with}}
                </div>

                <!-- RIGHT -->
                <div
                    class="w-[100px] md:w-[150px] aspect-square rounded-lg overflow-hidden border-[2px] border-white rotate-[15deg] -translate-x-[25px] translate-y-[10px]">
                    {{#with posts.[2]}}
                    {{#if feature_image}}
                    <img src="{{img_url feature_image}}" class="w-full h-full object-cover">
                    {{/if}}
                    {{/with}}
                </div>

                {{!-- CASE: 2 POSTS --}}
                {{else}}
                {{#match posts.length "=" 2}}

                <!-- CENTER -->
                <div class="w-[150px] md:w-[200px] aspect-square rounded-lg overflow-hidden border-[2px] border-white">
                    {{#with posts.[0]}}
                    {{#if feature_image}}
                    <img src="{{img_url feature_image}}" class="w-full h-full object-cover">
                    {{/if}}
                    {{/with}}
                </div>

                <!-- RIGHT -->
                <div
                    class="w-[100px] md:w-[150px] aspect-square rounded-lg overflow-hidden border-[2px] border-white rotate-[15deg] -translate-x-[25px] translate-y-[10px]">
                    {{#with posts.[1]}}
                    {{#if feature_image}}
                    <img src="{{img_url feature_image}}" class="w-full h-full object-cover">
                    {{/if}}
                    {{/with}}
                </div>

                {{!-- CASE: 1 POST --}}
                {{else}}
                {{#match posts.length "=" 1}}

                <!-- CENTER -->
                <div class="w-[150px] md:w-[200px] aspect-square rounded-lg overflow-hidden border-[2px] border-white">
                    {{#with posts.[0]}}
                    {{#if feature_image}}
                    <img src="{{img_url feature_image}}" class="w-full h-full object-cover">
                    {{/if}}
                    {{/with}}
                </div>

                {{!-- CASE: 0 POSTS --}}
                {{else}}

                <!-- FALLBACK: SITE COVER -->
                {{#if @site.cover_image}}
                <div class="w-[150px] md:w-[200px] aspect-square rounded-lg overflow-hidden border-[2px] border-white">
                    <img src="{{@site.cover_image}}" class="w-full h-full object-cover">
                </div>
                {{/if}}

                {{/match}}
                {{/match}}
                {{/match}}


            </div>

            {{/get}}
            {{#get "pages" filter="tag:hash-static-text-section" limit="1"}}
            {{#if pages}}
            {{#foreach pages}}
            <h2 class="text-3xl md:text-4xl lg:text-5xl leading-[1.05] mb-6">
                {{title}}
            </h2>
            <p class="text-base mb-10 max-w-2xl mx-auto">
                {{excerpt}}
            </p>
            {{/foreach}}
            {{/if}}
            {{/get}}

            {{#match @custom.hero_actions "Subscription form"}}
            <form class="flex flex-col md:flex-row items-center justify-center gap-3.5 max-w-lg mx-auto">
                <input type="email" placeholder="Your Email"
                    class="w-full px-6 py-3 rounded-lg border border-transparent bg-white shadow-[0_2px_15px_-3px_rgba(0,0,0,0.08),0_10px_20px_-2px_rgba(0,0,0,0.04)] text-gray-900 placeholder:text-gray-400 focus:border-[#6366F1]/30 focus:ring-4 focus:ring-[#6366F1]/5 transition-all outline-none"
                    required>
                <button type="submit"
                    class="w-full md:w-auto min-w-[140px] px-8 py-3 rounded-lg bg-[#5ECC1D] hover:bg-[#52B418] text-white font-bold transition-all shadow-lg hover:shadow-xl active:scale-[0.98]">
                    Subscribe
                </button>
            </form>
            {{else}}
            {{#match @custom.hero_actions "Social links"}}
            <div>
                <p>ye wale social links hai</p>
            </div>
            {{/match}}
            {{/match}}


        </div>



    </section>

    {{!-- Meet the Authors Section --}}
    {{#get "pages" filter="tag:hash-authors-section" limit="1" include ="tags"}}
    {{#if pages}}
    {{#foreach pages}}
     {{#has tag="#no-title"}}
                {{!-- do nothing --}}
            {{else}}
    <section class="py-[70px] bg-white">
        <div class="container">
            <div class="flex items-center justify-between mb-[25px]">
                <h2 class="text-2xl md:text-3xl font-bold tracking-tight">{{title}}</h2>
                <a href={{url}} class="text-sm font-medium flex items-center gap-2 group/link">
                    <span>View All</span>
                    <svg class="w-4 h-4 transform group-hover/link:translate-x-1 transition-transform"
                        viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                        stroke-linejoin="round">
                        <path d="M5 12h14M12 5l7 7-7 7" />
                    </svg>
                </a>
            </div>

            {{#get "authors" limit="6" include="count.posts"}}
            <div class="grid grid-cols-2 lg:grid-cols-6 gap-x-8">
                {{#foreach authors}}
                <div class="group flex flex-col">
                    <a href="{{url}}"
                        class="relative block aspect-[1/1.2] rounded-2xl overflow-hidden bg-gray-50 mb-4 shadow-sm border border-gray-100">
                        {{#if profile_image}}
                        <img src="{{img_url profile_image size=" m"}}" alt="{{name}}"
                            class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 ease-in-out">
                        {{else}}
                        <div class="w-full h-full flex items-center justify-center text-gray-200">
                            <svg class="w-20 h-20 opacity-30" fill="currentColor" viewBox="0 0 24 24">
                                <path
                                    d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
                            </svg>
                        </div>
                        {{/if}}
                        <div class="absolute inset-0 bg-black/5 opacity-0 group-hover:opacity-100 transition-opacity">
                        </div>
                    </a>
                    <div class="flex flex-col">
                        <h3 class="text-base font-bold leading-tight mb-1">
                            <a href="{{url}}" class="hover:text-[#0A66C2] transition-colors">{{name}}</a>
                        </h3>
                        <p class="text-[13px] line-clamp-2 leading-relaxed mb-3">
                            {{#if bio}}{{bio}}{{else}}Active contributor and creative writer sharing insights and
                            stories.{{/if}}
                        </p>
                        <a href="{{#if website}}{{website}}{{else}}{{url}}{{/if}}" target="_blank" rel="noopener"
                            class="text-xs font-bold flex items-center gap-1">
                            View on <span class="text-[#0A66C2]">Linkedin</span>
                        </a>
                    </div>
                </div>
                {{/foreach}}
            </div>
            {{/get}}
        </div>
    </section>
{{/has}}
    {{/foreach}}
    {{/if}}
    {{/get}}


    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const thumbsSwiper = new Swiper(".thumbs-swiper", {
                slidesPerView: "auto",
                freeMode: true,
                watchSlidesVisibility: true,
                watchSlidesProgress: true,
            });

            const mainSwiper = new Swiper(".main-swiper", {
                spaceBetween: 10,
                effect: 'fade',
                fadeEffect: {
                    crossFade: true
                },
                thumbs: {
                    swiper: thumbsSwiper,
                },
                navigation: {
                    nextEl: ".swiper-button-next-custom",
                    prevEl: ".swiper-button-prev-custom",
                },
                on: {
                    slideChange: function () {
                        const activeIndex = this.realIndex + 1;
                        document.querySelector('.active-index').textContent = activeIndex;
                    }
                }
            });

            // Tab Switching Logic
            const tabBtns = document.querySelectorAll('.tab-btn');
            const tabGrids = document.querySelectorAll('.tab-grid');
            const viewAllLink = document.getElementById('view-all-link');

            tabBtns.forEach(btn => {
                btn.addEventListener('click', () => {
                    const tabId = btn.getAttribute('data-tab');

                    // Update buttons
                    tabBtns.forEach(b => {
                        b.classList.remove('active');
                    });
                    btn.classList.add('active');

                    // Update grids
                    tabGrids.forEach(grid => grid.classList.add('hidden'));
                    document.getElementById(`tab-${tabId}`).classList.remove('hidden');

                    // Update View All link if needed
                    if (tabId === 'all') {
                        viewAllLink.href = '/archive';
                    } else {
                        viewAllLink.href = `/tag/${tabId}`;
                    }
                });
            });
        });
    </script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {

            const POSTS_PER_LOAD = 8;

            // TAB SWITCHING
            const tabBtns = document.querySelectorAll('.tab-btn');
            const tabGrids = document.querySelectorAll('.tab-grid');

            tabBtns.forEach(btn => {
                btn.addEventListener('click', () => {
                    const tabId = btn.dataset.tab;

                    tabBtns.forEach(b => b.classList.remove('active'));
                    btn.classList.add('active');

                    tabGrids.forEach(grid => grid.classList.add('hidden'));
                    const activeTab = document.getElementById(`tab-${tabId}`);
                    activeTab.classList.remove('hidden');

                    // Reset show more when switching tab
                    initTab(activeTab, true);
                });
            });

            // INIT EACH TAB
            function initTab(tab, reset = false) {
                const posts = tab.querySelectorAll('.post-item');
                const btn = tab.querySelector('.show-more-btn');

                if (!posts.length) return;

                if (reset) {
                    posts.forEach(p => p.classList.add('hidden'));
                    tab.dataset.visible = 0;
                }

                let visible = parseInt(tab.dataset.visible || 0);

                function showNext() {
                    for (let i = visible; i < visible + POSTS_PER_LOAD; i++) {
                        if (posts[i]) {
                            posts[i].classList.remove('hidden');
                        }
                    }

                    visible += POSTS_PER_LOAD;
                    tab.dataset.visible = visible;

                    if (btn && visible >= posts.length) {
                        btn.style.display = 'none';
                    } else if (btn) {
                        btn.style.display = 'inline-block';
                    }
                }

                // Prevent multiple bindings
                if (!tab.dataset.initialized) {
                    showNext();

                    if (btn) {
                        btn.addEventListener('click', showNext);
                    }

                    tab.dataset.initialized = "true";
                } else if (reset) {
                    if (btn) btn.style.display = 'inline-block';
                    showNext();
                }
            }

            // INIT ALL TABS ON LOAD
            document.querySelectorAll('.tab-grid').forEach(tab => {
                initTab(tab);
            });

        });
    </script>
    </main>