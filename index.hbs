{{!< default}} {{!-- The tag above means: insert everything in this file into the {body} of the default.hbs template
    --}} <main id="site-main" class="site-main outer">
    {{!-- Featured Slider Section --}}
    {{#get "posts" limit=@custom.number_of_featured_posts include="tags,authors" filter="featured:true" as |featured|}}
    {{#if featured}}
    <section class="featured-posts py-[50px] border-b border-border">
        <div class="container">
            <div class="main-swiper swiper overflow-hidden relative">
                <div class="swiper-wrapper">
                    {{#foreach featured}}
                    <div class="swiper-slide flex flex-col justify-center">
                        {{!-- Main Content Wrapper: Groups Text and Image --}}
                        <div class="featured-slider-card h-full grid grid-cols-1 lg:grid-cols-[1fr_1.4fr] gap-12">
                            {{!-- Text Content --}}
                            <div class="slide-content">
                                <div class="flex items-center gap-4 mb-7">

                                    {{#foreach tags visibility="public"}}
                                    {{#if @first}}
                                    <div class="flex gap-2">
                                        {{/if}}
                                        <span
                                            class="px-3 py-1 min-h-[20px] flex items-center bg-alternate rounded-sm text-xs border border-border">{{name}}</span>

                                        {{#if @last}}
                                    </div>
                                    {{/if}}
                                    {{/foreach}}


                                    <span class="text-xs font-medium">{{reading_time}}</span>
                                </div>
                                <h2 class="text-5xl mb-5 max-w-[550px]">
                                    <a href="{{url}}">{{title}}</a>
                                </h2>
                                <p class="text-sm line-clamp-3 max-w-[450px] font-medium mb-8">
                                    {{excerpt}}
                                </p>
                                {{> "author-group"}}
                            </div>

                            {{!-- Right Large Image --}}
                            <div
                                class="relative bg-alternate text-text/50 h-[690px] rounded-[20px] overflow-hidden flex items-center justify-center">
                                {{#if feature_image}}
                                <img src="{{img_url feature_image size=" l"}}" alt="{{title}}"
                                    class="w-full h-full object-cover">
                                {{else}}
                                <span>NO IMAGE</span>
                                {{/if}}
                                <a href="{{url}}" class="overlaylink"></a>
                            </div>
                        </div>
                    </div>
                    {{/foreach}}
                </div>
                {{#if featured.[1]}}
                <div
                    class="navigation-wrapper absolute z-1 bottom-[50px] left-0 w-full max-w-[56%] flex items-end justify-between gap-12 p-[10px] bg-main rounded-lg">
                    <div class="flex items-center gap-5">
                        <div class="flex gap-2">
                            <button
                                class="swiper-button-prev-custom w-12 h-12 rounded-full flex items-center justify-center bg-alternate hover:bg-text hover:text-main text-heading transition-all shadow-[0px_0px_30px_0px_#1C1D580D] cursor-pointer">
                                <svg width="9" height="9" viewBox="0 0 6 10" fill="none">
                                    <path opacity="0.9"
                                        d="M5.96381 1.33189L2.57066 4.84441L5.96381 8.35694L4.67846 9.6875L-2.43187e-05 4.84441L4.67846 0.0013237L5.96381 1.33189Z"
                                        fill="currentColor" />
                                </svg>
                            </button>
                            <button
                                class="swiper-button-next-custom w-12 h-12 rounded-full flex items-center justify-center bg-alternate hover:bg-text hover:text-main text-heading transition-all shadow-[0px_0px_30px_0px_#1C1D580D] cursor-pointer">
                                <svg width="9" height="9" viewBox="0 0 6 10" fill="none">
                                    <path opacity="0.9"
                                        d="M0 1.33189L3.39315 4.84441L0 8.35694L1.28534 9.6875L5.96383 4.84441L1.28534 0.0013237L0 1.33189Z"
                                        fill="currentColor" />
                                </svg>

                            </button>
                        </div>
                        <div class="swiper-pagination-custom text-text font-medium">
                            <span class="active-index text-heading text-xl">1</span>/{{featured.length}}
                        </div>
                    </div>
                    <div class="thumbs-swiper-wrapper max-w-[560px]">
                        <div class="thumbs-swiper swiper">
                            <div class="swiper-wrapper">
                                {{#foreach featured}}
                                <div class="swiper-slide !w-auto pr-2.5">
                                    <div
                                        class="thumb-card w-[130px] xl:w-[180px] aspect-1/1 bg-alternate text-text rounded-lg overflow-hidden transition-all cursor-pointer">
                                        {{#if feature_image}}
                                        <img src="{{img_url feature_image size=" s"}}" alt="{{title}}"
                                            class="rounded-lg w-full h-full object-cover">
                                        {{else}}
                                        <div class="w-full h-full flex items-center justify-center">
                                            <span class="">NO IMAGE</span>
                                        </div>
                                        {{/if}}
                                    </div>
                                </div>
                                {{/foreach}}
                            </div>
                        </div>
                    </div>
                </div>
                {{/if}}
            </div>
        </div>
    </section>
    {{/if}}
    {{/get}}

    {{!-- All posts Section --}}
    <section class="latest-articles py-[70px]">
        <div class="container">
            <!-- HEADER -->
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-[25px] gap-6">
                <h2 class="text-2xl md:text-3xl tracking-tight">{{@custom.home_feed_title}}</h2>
                <div class="flex flex-wrap items-center gap-3">
                    <button
                        class="filter-tab-btn cursor-pointer tab-btn active px-5 py-1.5 rounded-lg text-sm bg-text/4 border border-border"
                        data-tab="all">
                        All
                    </button>
                    {{#get "tags" filter="slug:[{{@custom.home_feed_tags}}]"}}
                    {{#foreach tags}}
                    <button
                        class="filter-tab-btn cursor-pointer tab-btn px-5 py-1.5 rounded-lg text-sm bg-text/4 border border-border"
                        data-tab="{{slug}}">
                        {{name}}
                    </button>
                    {{/foreach}}
                    {{/get}}
                </div>
            </div>
            <div class="tab-content">
                <!-- ALL TAB -->
                <div id="tab-all" class="tab-grid">
                    {{#get "posts" limit="50" include="tags,authors" order="published_at desc"}}
                    <div class="posts-container grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                        {{#foreach posts}}
                        <div class="post-item hidden">
                            {{> post-card}}
                        </div>
                        {{/foreach}}
                    </div>
                    <div class="text-center mt-10">
                        <button class="show-more-btn button button-outline cursor-pointer">
                            Show More
                        </button>
                    </div>
                    {{/get}}
                </div>
                <!-- TAG TABS -->
                {{#get "tags" filter="slug:[{{@custom.home_feed_tags}}]"}}
                {{#foreach tags}}
                <div id="tab-{{slug}}" class="tab-grid hidden">
                    {{#get "posts" limit="50" include="tags,authors" filter="tag:{{slug}}" order="published_at desc"}}
                    <div class="posts-container grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                        {{#foreach posts}}
                        <div class="post-item hidden">
                            {{> post-card}}
                        </div>
                        {{/foreach}}
                    </div>
                    <div class="text-center mt-10">
                        <button class="show-more-btn button button-outline">
                            Show More
                        </button>
                    </div>
                    {{/get}}
                </div>
                {{/foreach}}
                {{/get}}
            </div>
        </div>
    </section>

    {{!-- recommended post section --}}
    <section class="recommended-posts">
        {{#get "posts" limit="3" include="tags,authors" filter="tag:hash-recommended" order="published_at desc"}}
        <div class="flex overflow-hidden">
            {{#foreach posts}}
            <div
                class="group card relative min-h-[80dvh] p-5 flex items-center justify-center flex-1 hover:flex-[1.3] transition-all duration-400">
                <div
                    class="absolute inset-0 overflow-hidden bg-alternate text-text/50 flex items-center justify-center min-w-[50vw]">
                    {{#if feature_image}}
                    <img src="{{img_url feature_image size=" m"}}" alt="{{title}}" class="w-full h-full object-cover" />
                    {{else}}
                    <span class="font-bold">NO IMAGE</span>
                    {{/if}}
                </div>
                <article id="article-card-{{@index}}"
                    class="relative z-1 article-card group flex flex-col w-full max-w-[450px] mx-auto opacity-0 group-hover:opacity-100 transition-all duration-400 ease">
                    <div id="article-card-iamge-{{@index}}"
                        class="border-16 border-alternate rounded-t-xl article-card-image aspect-[3/2]"> </div>
                    <div class="bg-alternate p-4 pb-[0px] rounded-b-xl">
                        {{! Category Tag }}

                        {{#foreach tags visibility="public"}}
                        {{#if @first}}
                        <div class="flex gap-2 mb-4">
                            {{/if}}
                            <span
                                class="px-3 py-1 min-h-[20px] flex items-center bg-alternate rounded-sm text-xs border border-border-light">{{name}}</span>


                            {{#if @last}}
                        </div>
                        {{/if}}
                        {{/foreach}}
                        {{! Title }}
                        <h3 class="text-md md:text-xl mb-4 pr-[10px]"> {{title}} </h3>

                        {{! Excerpt }}
                        {{#if excerpt}}
                        <p class="line-clamp-3 mb-5 pr-[10px]"> {{excerpt}}</p>
                        {{/if}}

                        {{! Footer Metadata }}
                        <div class="mt-auto py-[15px] border-t border-border-light flex items-center justify-between">
                            {{> "author-group"}}
                        </div>
                    </div>
                    <a href="{{url}}" class="overlaylink"></a>
                </article>
            </div>
            {{/foreach}}
        </div>
        {{/get}}
    </section>

    {{!-- Latest Posts Section with Dual-State Hover Effect --}}
    {{#if @custom.home_tags_section}}
    <section class="tag-posts pbs-[70px]">
        <div class="container">
            <div class="bg-alternate rounded-[30px] p-[40px]">
                {{!-- PAGE BLOCK --}}
                {{#get "pages" filter="tag:hash-categories-posts" limit="1"}}
                {{#if pages}}
                {{#foreach pages}}
                <div class="text-center max-w-[600px] mx-auto mb-8">
                    <h2 class="text-4xl md:text-5xl font-bold mb-3">{{title}}</h2>
                    {{#if excerpt}}
                    <p>{{excerpt}}</p>
                    {{/if}}
                </div>
                {{/foreach}}
                {{/if}}
                {{/get}}

                {{!-- TAGS BLOCK --}}
                <div class="tag-posts-list">
                    {{#get "tags" filter="slug:[{{@custom.home_tags_section}}]"}}
                    {{#if tags}}

                    {{#foreach tags}}
                    <div class="mb-12">
                        <h2 class="text-xl mb-6 tag-post-title">{{name}}</h2>
                        {{#get "posts" limit="4" include="tags,authors" filter="tag:{{slug}}" order="published_at
                        desc"}}

                        {{#if posts}}
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
                            {{#foreach posts}}
                            <a href="{{url}}"
                                class="group relative flex flex-col bg-main rounded-[10px] overflow-hidden aspect-[3/4] cursor-pointer">

                                {{!-- Enhanced Image Expansion Layer --}}
                                <div
                                    class="absolute inset-0 m-auto [clip-path:circle(28%_at_50%_45%)] group-hover:[clip-path:circle(100%_at_50%_50%)] overflow-hidden transition-all duration-700 ease-in-out">
                                    {{#if feature_image}}
                                    <img src="{{img_url feature_image size=" l"}}" alt="{{title}}"
                                        class="w-full h-full object-cover">
                                    {{/if}}
                                </div>

                                {{!-- Normal State Content --}}
                                <div class="relative flex flex-col h-full justify-between px-[14px] py-[20px]">
                                    <div class="flex gap-2">
                                        {{#foreach tags visibility="public"}}
                                        {{#if @first}}
                                        <div class="flex gap-2 mb-4">
                                            {{/if}}
                                            <span
                                                class="px-4 py-1 min-h-[20px] flex items-center bg-alternate rounded-sm text-xs border border-border-light">
                                                {{name}}
                                            </span>
                                            {{#if @last}}
                                        </div>
                                        {{/if}}
                                        {{/foreach}}
                                    </div>
                                    <div class="w-full">
                                        <span
                                            class="text-xs font-medium mb-1 text-white opacity-0 group-hover:opacity-70 transition-all ease-in">{{date
                                            format="MMM DD, YYYY"}}</span>
                                        <div
                                            class="text-base font-bold text-black dark:text-white group-hover:text-white transition-all ease-in">
                                            {{title}}
                                        </div>
                                    </div>
                                </div>
                            </a>
                            {{/foreach}}
                        </div>
                        {{else}}
                        <div class="py-10 text-center text-text">
                            No posts found in {{name}}
                        </div>
                        {{/if}}

                        {{/get}}
                    </div>
                    {{/foreach}}

                    {{/if}}
                    {{/get}}
                </div>

            </div>
        </div>
    </section>
    {{/if}}

    {{!-- Read by Category Section --}}
    <section class="pbs-[70px]">
        <div class="container">
            <div class="flex items-center justify-between mb-[25px]">
                <h2 class="text-2xl md:text-3xl font-bold tracking-tight">{{@custom.category_title}}</h2>
            </div>
            {{#get "tags" limit="all" include="count.posts" order="count.posts desc"}}
            <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-6">
                {{#foreach tags}}
                <a href="{{url}}"
                    class="group flex flex-col gap-3 hover:translate-y-[-10px] transition-transform duration-500 ease-in-out">
                    <div
                        class="relative aspect-square bg-alternate text-text/20 flex items-center justify-center rounded-lg overflow-hidden group-hover:shadow-lg transition-shadow duration-500 ease-in-out">
                        {{#if feature_image}}
                        <img src="{{img_url feature_image size=" s"}}" alt="{{name}}"
                            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-in-out">
                        {{else}}
                        <span class="font-bold">NO IMAGE</span>
                        {{/if}}
                    </div>
                    <div class="flex flex-col">
                        <h3 class="text-base leading-tight group-hover:!text-accent transition-all ease-in">{{name}}
                        </h3>
                        <span class="text-xs mt-1">{{count.posts}} articles</span>
                    </div>
                </a>
                {{/foreach}}
            </div>
            {{/get}}
        </div>
    </section>

    {{!-- Newsletter Hero Section --}}
