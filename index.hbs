{{!< default}} {{!-- The tag above means: insert everything in this file into the {body} of the default.hbs template
    --}} <main id="site-main" class="site-main outer">
    {{!-- Featured Slider Section --}}
    {{#get "posts" limit=@custom.number_of_featured_posts include="tags,authors" filter="featured:true" as |featured|}}
    {{#if featured}}
    <section class="featured-posts py-[50px] border-b border-border">
        <div class="container">
            <div class="main-swiper swiper overflow-hidden relative">
                <div class="swiper-wrapper">
                    {{#foreach featured}}
                    <div class="swiper-slide flex flex-col justify-center">
                        {{!-- Main Content Wrapper: Groups Text and Image --}}
                        <div class="featured-slider-card h-full grid grid-cols-1 lg:grid-cols-[1fr_1.4fr] gap-10 md:gap-12">
                            {{!-- Text Content --}}
                            <div class="slide-content" data-aos="fade-in" data-aos-duration="600">
                                <div class="flex items-center flex-wrap gap-1.5 mb-5 md:mb-7">
                                    {{#if featured}}
                                    <div
                                        class="bg-[#FFF9E6] text-black border border-[#FFC107] px-2 py-1 rounded-sm text-xs inline-flex items-center gap-1">
                                        {{> "icons/fire"}}{{t "Featured"}}</div>
                                    {{/if}}
                                    {{> "tagsList"}}
                                    <span class="text-xs font-medium pl-2 min-w-[90px]">{{reading_time}}</span>
                                    {{#unless access}}
                                    {{^has visibility="public"}}
                                    <span
                                        class="ml-4 flex justify-center items-center border border-dashed border-heading text-heading w-7 h-7 rounded-full">
                                        {{> "icons/lock"}}
                                    </span>
                                    {{/has}}
                                    {{/unless}}
                                </div>
                                <h2 class="text-3xl md:text-4xl lg:text-5xl mb-5 max-w-[550px]">
                                    <a href="{{url}}">{{title}}</a>
                                </h2>
                                {{#if custom_excerpt}}
                                    <p class="text-sm line-clamp-3 max-w-[450px] font-medium mb-5 md:mb-8">{{custom_excerpt}}</p>
                                {{/if}}
                                {{#unless custom_excerpt}}
                                    {{#if excerpt}}
                                     <p class="text-sm line-clamp-3 max-w-[450px] font-medium mb-5 md:mb-8">{{excerpt}}</p>
                                    {{/if}}
                                {{/unless}}
                                {{> "author-group"}}
                            </div>

                            {{!-- Right Large Image --}}
                            <div
                                class="group featured-post-img relative bg-alternate text-text/50 h-[400px] lg:h-[690px] rounded-[20px] overflow-hidden flex items-center justify-center">
                                {{#if feature_image}}
                                <img src="{{img_url feature_image size="m"}}" data-src="{{img_url feature_image size="m"}}" alt="{{title}}" loading="lazy"
                                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105 progressive-load lazyload">
                                {{else}}
                                <span>{{t "NO IMAGE"}}</span>
                                {{/if}}
                                <a href="{{url}}" class="overlaylink" aria-label="{{title}}"></a>
                            </div>
                        </div>
                    </div>
                    {{/foreach}}
                </div>
                {{#if featured.[1]}}
                <div
                    class="navigation-wrapper -mt-[30px] lg:mt-0 relative lg:absolute z-1 lg:bottom-[50px] lg:left-0 w-full mx-auto max-w-[273px] lg:max-w-[70%] xl:max-w-[56%] flex flex-col-reverse lg:flex-row items-center lg:items-end justify-between gap-8 lg:gap-12 px-[5px] py-[8px] lg:px-[10px] lg:py-[10px] bg-main rounded-lg overflow-hidden">
                    <div class="flex items-center gap-5">
                        <div class="flex gap-2">
                            <button
                                class="swiper-button-prev-custom w-10 h-10 md:w-12 md:h-12 rounded-full flex items-center justify-center bg-alternate hover:bg-text hover:text-main text-heading transition-all shadow-[0px_0px_30px_0px_#1C1D580D] cursor-pointer">
                                <svg width="9" height="9" viewBox="0 0 6 10" fill="none">
                                    <path opacity="0.9"
                                        d="M5.96381 1.33189L2.57066 4.84441L5.96381 8.35694L4.67846 9.6875L-2.43187e-05 4.84441L4.67846 0.0013237L5.96381 1.33189Z"
                                        fill="currentColor" />
                                </svg>
                            </button>
                            <button
                                class="swiper-button-next-custom w-10 h-10 md:w-12 md:h-12 rounded-full flex items-center justify-center bg-alternate hover:bg-text hover:text-main text-heading transition-all shadow-[0px_0px_30px_0px_#1C1D580D] cursor-pointer">
                                <svg width="9" height="9" viewBox="0 0 6 10" fill="none">
                                    <path opacity="0.9"
                                        d="M0 1.33189L3.39315 4.84441L0 8.35694L1.28534 9.6875L5.96383 4.84441L1.28534 0.0013237L0 1.33189Z"
                                        fill="currentColor" />
                                </svg>

                            </button>
                        </div>
                        <div class="swiper-pagination-custom text-text font-medium text-sm">
                            <span class="active-index text-heading text-lg">1</span>/{{featured.length}}
                        </div>
                    </div>
                    <div class="thumbs-swiper-wrapper max-w-[100%] lg:max-w-[485px] 2xl:max-w-[560px]">
                        <div class="thumbs-swiper swiper">
                            <div class="swiper-wrapper">
                                {{#foreach featured}}
                                <div class="swiper-slide !w-auto px-1">
                                    <div
                                        class="thumb-card w-[80px] lg:w-[155px] 2xl:w-[180px] aspect-1/1 bg-alternate text-text rounded-xl overflow-hidden transition-all cursor-pointer">
                                        {{#if feature_image}}
                                        <img src="{{img_url feature_image size="xs"}}" data-src="{{img_url feature_image size="m"}}" loading="lazy" alt="{{title}}"
                                            class="rounded-lg w-full h-full object-cover progressive-load lazyload">
                                        {{else}}
                                        <div class="w-full h-full flex items-center justify-center">
                                            <span class="">{{t "NO IMAGE"}}</span>
                                        </div>
                                        {{/if}}
                                    </div>
                                </div>
                                {{/foreach}}
                            </div>
                        </div>
                    </div>
                </div>
                {{/if}}
            </div>
        </div>
    </section>
    {{/if}}
    {{/get}}

    {{!-- All posts Section --}}
    <section class="latest-articles pt-[40px] md:pt-[60px] lg:pt-[70px]">
        <div class="container">
            <!-- HEADER -->
            <div class="flex flex-col lg:flex-row justify-between items-start lg:items-center mb-[25px] gap-5 lg:gap-6">
                <h2 class="text-2xl md:text-3xl tracking-tight">{{@custom.home_feed_title}}</h2>
                <div class="flex flex-wrap items-center md:justify-end gap-1">
                    <button
                        class="filter-tab-btn cursor-pointer tab-btn active px-5 py-2 rounded-lg text-xs bg-alternate/50 border border-border"
                        data-tab="all">
                        {{t "All"}}
                    </button>
                    {{#if @custom.home_feed_tags}}
                    {{#get "tags" filter="slug:[{{@custom.home_feed_tags}}]"}}
                    {{#foreach tags}}
                    <button
                        class="filter-tab-btn cursor-pointer tab-btn px-5 py-2 rounded-lg text-xs bg-alternate/50 border border-border"
                        data-tab="{{slug}}">
                        {{name}}
                    </button>
                    {{/foreach}}
                    {{/get}}
                    {{/if}}
                </div>
            </div>
            <div class="tab-content">
                <!-- ALL TAB -->
                <div id="tab-all" class="tab-grid">
                    {{#get "posts" limit="50" include="tags,authors" order="published_at desc"}}
                    <div class="posts-container grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
                        {{#foreach posts}}
                        <div class="post-item hidden">
                            {{> post-card}}
                        </div>
                        {{/foreach}}
                    </div>
                    <div class="text-center  justify-center mt-5 md:mt-10">
                        <button class="show-more-btn button button-outline button-large">
                            <span class="button-text relative overflow-hidden">
                                <span class="button-text-inner top-text">{{t "Show More"}}</span>
                                <span class="button-text-inner bottom-text">{{t "Show More"}}</span>
                            </span>
                        </button>
                    </div>
                    {{/get}}
                </div>
                <!-- TAG TABS -->
                
                {{#get "tags" filter="slug:[{{@custom.home_feed_tags}}]"}}
                {{#foreach tags}}
                <div id="tab-{{slug}}" class="tab-grid hidden">
                    {{#get "posts" limit="50" include="tags,authors" filter="tag:{{slug}}" order="published_at desc"}}
                    <div class="posts-container grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
                        {{#foreach posts}}
                        <div class="post-item hidden">
                            {{> post-card}}
                        </div>
                        {{/foreach}}
                    </div>
                    <div class="text-center justify-center mt-5 md:mt-10">
                        <button class="show-more-btn button button-outline button-large">
                            <span class="button-text relative overflow-hidden">
                                <span class="button-text-inner top-text">{{t "Show More"}}</span>
                                <span class="button-text-inner bottom-text">{{t "Show More"}}</span>
                            </span>
                        </button>
                    </div>
                    {{/get}}
                </div>
                {{/foreach}}
                {{/get}}
            </div>
        </div>
    </section>

    {{!-- Latest Posts Section with Dual-State Hover Effect --}}
    {{#if @custom.home_tags_section}}
    <section class="tag-posts pt-[40px] md:pt-[60px] lg:pt-[70px]">
        <div class="container">
            <div class="bg-alternate rounded-[20px] md:rounded-[30px] py-[40px] px-[20px] md:px-[30px] lg:px-[40px]">
                {{!-- PAGE BLOCK --}}
                {{#get "pages" filter="tag:hash-categories-posts" limit="1"}}
                {{#if pages}}
                {{#foreach pages}}
                <div class="text-center max-w-[600px] mx-auto mb-4 md:mb-6" >
                    {{#match title "~" "|"}}
                    {{#foreach (split title separator="|")}}
                    {{#unless @last}}
                        {{!-- Badge --}}
                            <div
                                class="inline-flex items-center justify-center gap-1 rounded-full px-4 py-1.5 mb-4 lg:mb-5 border-2 border-accent text-heading" data-aos="fade-up" data-aos-duration="600">
                                <svg width="13" height="13" viewBox="0 0 13 13" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M6.422 0.00405997C6.38979 0.0139994 6.35708 0.0222331 6.324 0.0287266C6.26746 0.0468719 6.21511 0.0761085 6.17 0.114727C6.01467 0.245393 6.00133 0.299393 5.97933 0.913393C5.93667 2.08473 5.74133 3.02206 5.38467 3.75873C4.68667 5.20139 3.27733 5.90273 0.904 5.98873C0.308 6.01006 0.244667 6.02406 0.125333 6.15539C0.0306666 6.26006 0 6.34406 0 6.49806C0 6.65206 0.0306666 6.73606 0.125333 6.84073C0.244 6.97206 0.309333 6.98606 0.888667 7.00739C1.68 7.03673 2.138 7.09606 2.73 7.24473C4.68867 7.73673 5.65 8.95473 5.92933 11.2981C5.94533 11.4374 5.968 11.7974 5.97933 12.0981C6 12.6594 6.01 12.7134 6.12533 12.8407C6.216 12.9407 6.33067 12.9867 6.48867 12.9867C6.64667 12.9867 6.76133 12.9407 6.852 12.8407C6.96667 12.7134 6.97733 12.6594 6.998 12.0981C7.02067 11.4974 7.04933 11.1947 7.128 10.7514C7.506 8.61606 8.60667 7.51539 10.742 7.13739C11.1853 7.05939 11.488 7.03006 12.0887 7.00739C12.668 6.98606 12.7333 6.97206 12.852 6.84073C12.9467 6.73606 12.9773 6.65206 12.9773 6.49806C12.9773 6.34006 12.9307 6.22539 12.8313 6.13473C12.704 6.01939 12.6507 6.00939 12.0753 5.98873C9.50467 5.89539 8.11133 5.12139 7.43867 3.41139C7.17933 2.75206 7.03533 1.93273 6.998 0.911393C6.98467 0.539393 6.96667 0.328727 6.94333 0.284727C6.89443 0.190723 6.82003 0.112399 6.72867 0.0587266C6.658 0.02206 6.46667 -0.01194 6.422 0.00405997ZM6.55467 3.90473C6.63 4.10939 6.87933 4.56873 7.04867 4.81606C7.53733 5.52739 8.27667 6.11073 9.12867 6.45606L9.24867 6.50406L9.08867 6.57273C7.88133 7.09006 7.07667 7.89806 6.558 9.11139L6.484 9.28473L6.42133 9.13006C5.94533 7.96406 5.138 7.13473 3.97533 6.61739C3.84733 6.56073 3.75133 6.50539 3.762 6.49539C3.77333 6.48539 3.872 6.43873 3.982 6.39273C5.04 5.94873 5.93133 5.05539 6.38533 3.98473C6.434 3.87073 6.48133 3.77806 6.49067 3.77806C6.5 3.77806 6.52933 3.83473 6.55467 3.90473Z" fill="currentcolor"/>
                                </svg>
                                <span class="leading-tight text-xs md:text-sm">{{this}}</span>
                            </div>
                    {{/unless}}
                    {{/foreach}}
                    {{#foreach (split title separator="|")}}
                    {{#unless @first}}
                    <h2 class="text-3xl md:text-4xl lg:text-5xl mb-3" data-aos="fade-up" data-aos-duration="800">{{this}}</h2>
                    {{/unless}}
                    {{/foreach}}
                    {{else}}
                    <h2 class="text-3xl md:text-4xl lg:text-5xl mb-3" data-aos="fade-up" data-aos-duration="800">{{title}}</h2>
                    {{/match}}
                    {{#if excerpt}}
                    <p class="text-sm md:text-base" data-aos="fade-up" data-aos-duration="800">{{excerpt}}</p>
                    {{/if}}
                </div>
                {{/foreach}}
                {{/if}}
                {{/get}}

                {{!-- TAGS BLOCK --}}
                <div class="tag-posts-list">
                    {{#get "tags" filter="slug:[{{@custom.home_tags_section}}]"}}
                    {{#if tags}}

                    {{#foreach tags}}
                    <div class="mt-7" data-aos="fade-up" data-aos-duration="800">
                        <h2 class="text-xl mb-6 tag-post-title">{{name}}</h2>
                        {{#get "posts" limit="4" include="tags,authors" filter="tag:{{slug}}" order="published_at desc"}}

                        {{#if posts}}
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
                            {{#foreach posts}}
                            <a href="{{url}}"
                                class="group relative flex flex-col bg-main rounded-[10px] overflow-hidden aspect-[3/4] cursor-pointer">

                                {{!-- Enhanced Image Expansion Layer --}}
                                <div
                                    class="absolute inset-0 m-auto xl:[clip-path:circle(28%_at_50%_45%)] group-hover:[clip-path:circle(100%_at_50%_50%)] overflow-hidden transition-all duration-700 ease-in-out">
                                    {{#if feature_image}}
                                    <img src="{{img_url feature_image size="xs"}}" data-src="{{img_url feature_image size="m"}}" loading="lazy" alt="{{title}}"
                                        class="w-full h-full object-cover progressive-load lazyload">
                                    {{/if}}
                                    <div class="absolute inset-0 opacity-100 xl:opacity-0 bg-[linear-gradient(180deg,_rgba(0,0,0,0)_0%,_rgba(0,0,0,0)_67.02%,_rgba(0,0,0,0.5)_79.23%,_#000000_100%)] md:bg-transparent md:group-hover:opacity-100 bg-[linear-gradient(180deg,_rgba(0,0,0,0)_0%,_rgba(0,0,0,0)_67.02%,_rgba(0,0,0,0.5)_79.23%,_#000000_100%)]"></div>
                                </div>

                                {{!-- Normal State Content --}}
                                <div class="relative flex flex-col h-full justify-between px-[14px] py-[20px]">
                                    <div class="flex gap-2 justify-between">
                                        <div class="flex items-start gap-1.5">
                                            {{#if featured}}
                                                <div class="bg-[#FFF9E6] text-black border border-[#FFC107] px-2 py-1 rounded-sm text-xs inline-flex items-center gap-1">
                                                {{> "icons/fire"}}{{t "Featured"}}</div>
                                            {{/if}}
                                            {{> "tagsList"}}
                                        </div>
                                        {{#unless access}}
                                        {{^has visibility="public"}}
                                        <span
                                            class="flex justify-center items-center border border-dashed border-white xl:border-heading text-white xl:text-heading bg-[#FFFFFF33] xl:bg-transparent backdrop-blur-[40px] xl:backdrop-blur-0 w-7 h-7 rounded-full group-hover:bg-[#FFFFFF33] group-hover:text-white group-hover:border-[#FFFFFF] group-hover:backdrop-blur-[40px]">
                                            {{> "icons/lock"}}
                                        </span>
                                        {{/has}}
                                        {{/unless}}
                                    </div>
                                    <div class="w-full">
                                        <span
                                            class="text-xs font-medium mb-1 text-white xl:opacity-0 group-hover:opacity-70 transition-all ease-in">{{date
                                            format="MMM DD, YYYY"}}</span>
                                        <div
                                            class="text-base font-bold text-white xl:text-black dark:text-white group-hover:text-white transition-all ease-in">
                                            {{title}}
                                        </div>
                                    </div>
                                </div>
                            </a>
                            {{/foreach}}
                        </div>
                        {{else}}
                        <div class="py-10 text-center text-text">
                            No posts found in {{name}}
                        </div>
                        {{/if}}

                        {{/get}}
                    </div>
                    {{/foreach}}

                    {{/if}}
                    {{/get}}
                </div>

            </div>
        </div>
    </section>
    {{/if}}

    {{!-- recommended post section --}}
    {{#get "posts" limit="3" include="tags,authors" filter="tag:hash-recommended" order="published_at desc"}}
    {{#if posts}}
        <section class="recommended-posts pt-[40px] md:pt-[60px] lg:pt-[70px] ">
            <div class="recommended-posts-container container">
                <div class="mobile-swipe mobile-swipe-cols-1">
                    <div class="flex gap-4 mobile-swipe-inner" data-aos="fade-up" data-aos-duration="700">
                        {{#foreach posts}}
                        <div class="group card recommended-card relative min-h-[50dvh] md:min-h-[60dvh] lg:min-h-[65dvh] xl:min-h-[75dvh] 2xl:min-h-[80dvh] px-5 py-10 rounded-[16px] md:rounded-[20px] overflow-hidden flex items-center justify-center flex-1 transition-all duration-400">
                            <div class="absolute inset-0 overflow-hidden bg-alternate text-text/50 flex items-center justify-center min-w-[30vw]">
                                {{#if feature_image}}
                                <img src="{{img_url feature_image size="xs"}}" data-src="{{img_url feature_image size="m"}}" loading="lazy" alt="{{title}}" class="w-full h-full object-cover progressive-load lazyload" />
                                {{else}}
                                <span class="font-bold">{{t "NO IMAGE"}}</span>
                                {{/if}}
                            </div>
                            <article id="article-card-{{@index}}"
                                class="recommended-post-card relative z-1 article-card group flex flex-col w-full max-w-[370px] mx-auto opacity-100 lg:opacity-0  transition-all duration-400 ease">
                                <div id="article-card-iamge-{{@index}}"
                                    class="border-16 border-alternate rounded-t-xl article-card-image aspect-[3/2] relative">
                                    
                                </div>
                                <div class="bg-alternate p-4 pb-[0px] rounded-b-xl">
                                    {{! Category Tag }}
                                    <div class="grid grid-cols-[1fr_auto] items-start">
                                        <div class="flex items-start flex-wrap gap-1.5 mb-4">
                                            {{#if featured}}
                                                <div class="bg-[#FFF9E6] text-black border border-[#FFC107] px-2 py-1 rounded-sm text-xs flex items-center gap-1">
                                                    {{> "icons/fire"}}{{t "Featured"}}
                                                </div>
                                            {{/if}}
                                            {{> "tagsList"}}
                                        </div>
                                        {{#unless access}}
                                        {{^has visibility="public"}}
                                        <span
                                            class="ml-3 flex justify-center items-center border border-dashed border-heading text-heading w-7 h-7 rounded-full">
                                            {{> "icons/lock"}}
                                        </span>
                                        {{/has}}
                                        {{/unless}}
                                    </div>
                                    {{! Title }}
                                    <h3 class="text-md md:text-xl mb-4 pr-[10px]"> {{title}} </h3>

                                    {{! Excerpt }}
                                    {{#if custom_excerpt}}
                                        <p class="line-clamp-3 mb-5 pr-[10px] text-sm">{{custom_excerpt}}</p>
                                    {{/if}}
                                    {{#unless custom_excerpt}}
                                        {{#if excerpt}}
                                            <p class="line-clamp-3 mb-5 pr-[10px]">{{excerpt}}</p>
                                        {{/if}}
                                    {{/unless}}

                                    {{! Footer Metadata }}
                                    <div class="mt-auto py-[15px] border-t border-border-light flex items-center justify-between">
                                        {{> "author-group"}}
                                    </div>
                                </div>
                                <a href="{{url}}" class="overlaylink" aria-label="{{title}}"></a>
                            </article>
                        </div>
                        {{/foreach}}
                    </div>
                </div>
            </div>
        </section>
        {{/if}}
    {{/get}}

    {{!-- Read by Category Section --}}
   {{#get "pages" filter="tag:hash-category" limit="1" include ="tags"}}
   {{#if pages}}
   {{#foreach pages}}
    <section class="py-[40px] md:py-[60px] lg:py-[70px]">
        <div class="container">
            <div class="flex items-center justify-between mb-[20px]">
                <h2 class="text-2xl md:text-3xl font-bold tracking-tight">{{title}}</h2>
                <a href={{url}}
                    class="text-xs text-heading font-medium flex items-center gap-2 group/link hover:text-accent transition-colors">
                    <span>{{t "View all"}} </span>
                    <svg width="9" height="8" viewBox="0 0 9 8" fill="none">
                        <path d="M5.4 0L4.77 0.63L7.29 3.15H0V4.05H7.29L4.77 6.57L5.4 7.2L9 3.6L5.4 0Z"
                            fill="currentColor" />
                    </svg>
                </a>
            </div>
            {{#get "tags" limit="6" include="count.posts" order="count.posts desc" filter="visibility:public"}}
            <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-x-4 md:gap-x-6 gap-y-5" data-aos="fade-up" data-aos-duration="800">
                {{#foreach tags}}
                <a href="{{url}}"
                    class="group flex flex-col gap-3 md:gap-4 hover:translate-y-[-10px] transition-transform duration-500 ease-in-out">
                    <div
                        class="relative aspect-square bg-alternate text-text/20 flex items-center justify-center rounded-lg overflow-hidden group-hover:shadow-lg transition-shadow duration-500 ease-in-out">
                        {{#if feature_image}}
                        <img src="{{img_url feature_image size="xs"}}" data-src="{{img_url feature_image size="m"}}" loading="lazy" alt="{{name}}"
                            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-in-out progressive-load lazyload">
                        {{else}}
                        <span class="font-bold">{{t "NO IMAGE"}}</span>
                        {{/if}}
                    </div>
                    <div class="flex flex-col">
                        <h3 class="text-base leading-tight group-hover:!text-accent transition-all ease-in">{{name}}
                        </h3>
                        <span class="text-xs mt-1">{{count.posts}} {{t "articles"}}</span>
                    </div>
                </a>
                {{/foreach}}
            </div>
            {{/get}}
        </div>
    </section>
   {{/foreach}}
   {{else}}
      <section class="py-[40px] md:py-[60px] lg:py-[70px]">
        <div class="container">
            <div class="flex items-center justify-between mb-[15px] lg:mb-[25px]">
                <h2 class="text-2xl md:text-3xl font-bold tracking-tight">Read by category</h2>
            </div>
