{{!< default}} {{!-- The tag above means: insert everything in this file into the {body} of the default.hbs template
    --}} <main id="site-main" class="site-main outer">
    {{!-- Featured Slider Section --}}
    {{#get "posts" limit=@custom.number_of_featured_posts include="tags,authors" filter="featured:true" as |featured|}}
    {{#if featured}}
    <section class="featured-posts py-[50px] border-b border-border">
        <div class="container">
            <div class="main-swiper swiper overflow-hidden relative">
                <div class="swiper-wrapper">
                    {{#foreach featured}}
                    <div class="swiper-slide flex flex-col justify-center">
                        {{!-- Main Content Wrapper: Groups Text and Image --}}
                        <div class="featured-slider-card h-full grid grid-cols-1 lg:grid-cols-[1fr_1.4fr] gap-12">
                            {{!-- Text Content --}}
                            <div class="slide-content">
                                <div class="flex items-center gap-4 mb-7">

                                    {{#foreach tags visibility="public"}}
                                    {{#if @first}}
                                    <div class="flex gap-2 mb-4">
                                        {{/if}}
                                        <span
                                            class="px-3 py-1 min-h-[20px] flex items-center bg-alternate rounded-sm text-xs border border-border">{{name}}</span>

                                        {{#if @last}}
                                    </div>
                                    {{/if}}
                                    {{/foreach}}


                                    <span class="text-xs font-medium">{{reading_time}}</span>
                                </div>
                                <h2 class="text-5xl mb-5 max-w-[550px]">
                                    <a href="{{url}}">{{title}}</a>
                                </h2>
                                <p class="text-sm line-clamp-3 max-w-[450px] font-medium mb-8">
                                    {{excerpt}}
                                </p>

                                <div class="author-group flex items-center">
                                    {{#if authors}}
                                    <div class="flex -space-x-3 mr-3">
                                        {{#foreach authors}}
                                        {{#if profile_image}}
                                        <img src="{{img_url profile_image size=" xs"}}" alt="{{name}}"
                                            class="w-9 h-9 rounded-full border-2 border-white object-cover shadow-sm bg-white"
                                            title="{{name}}">
                                        {{else}}
                                        <div class="w-9 h-9 rounded-full border-2 border-white bg-gray-200 flex items-center justify-center text-[10px] text-gray-500 shadow-sm"
                                            title="{{name}}">
                                           <svg width="15" height="15" viewBox="0 0 15 15" fill="none">
<path d="M0.415364 14.759C0.397364 14.759 0.397364 14.759 0.379364 14.759C0.145364 14.741 -0.0166362 14.543 0.00136381 14.327C0.235364 10.889 3.47536 8.20703 7.36336 8.20703C11.2514 8.20703 14.4914 10.889 14.7254 14.309C14.7434 14.543 14.5634 14.723 14.3474 14.741C14.1134 14.759 13.9334 14.579 13.9154 14.363C13.6994 11.357 10.8194 9.01703 7.36336 9.01703C3.88936 9.01703 1.00936 11.375 0.811364 14.381C0.793364 14.597 0.613364 14.759 0.415364 14.759Z" fill="currentColor"/>
<path d="M7.36377 8.208C5.09577 8.208 3.25977 6.372 3.25977 4.104C3.25977 1.836 5.09577 0 7.36377 0C9.63177 0 11.4678 1.836 11.4678 4.104C11.4678 6.372 9.63177 8.208 7.36377 8.208ZM7.36377 0.828C5.56377 0.828 4.08777 2.304 4.08777 4.104C4.08777 5.904 5.56377 7.38 7.36377 7.38C9.16377 7.38 10.6398 5.904 10.6398 4.104C10.6398 2.304 9.16377 0.828 7.36377 0.828Z" fill="currentColor"/>
</svg>
                                        </div>
                                        {{/if}}
                                        {{/foreach}}
                                    </div>
                                    {{/if}}
                                    <div class="flex flex-col justify-center">
                                        <h4 class="text-base">
                                            {{#foreach authors}}{{name}}{{#unless @last}}, {{/unless}}{{/foreach}}
                                        </h4>
                                        <span class="text-xs mt-0.5">Published on {{date format="DD MMM YYYY"}}</span>
                                    </div>
                                </div>
                            </div>

                            {{!-- Right Large Image --}}
                            <div
                                class="relative bg-alternate text-text/50 h-[690px] rounded-[20px] overflow-hidden flex items-center justify-center">
                                {{#if feature_image}}
                                <img src="{{img_url feature_image size=" l"}}" alt="{{title}}"
                                    class="w-full h-full object-cover">
                                {{else}}
                                <span>NO IMAGE</span>
                                {{/if}}
                                <a href="{{url}}" class="overlaylink"></a>
                            </div>
                        </div>
                    </div>
                    {{/foreach}}
                </div>
                {{#if featured.[1]}}
                <div
                    class="navigation-wrapper absolute z-1 bottom-[50px] left-0 w-full max-w-[56%] flex items-end justify-between gap-12 p-[10px] bg-main rounded-lg">
                    <div class="flex items-center gap-5">
                        <div class="flex gap-2">
                            <button
                                class="swiper-button-prev-custom w-12 h-12 rounded-full flex items-center justify-center bg-alternate hover:bg-text hover:text-main text-heading transition-all shadow-[0px_0px_30px_0px_#1C1D580D] cursor-pointer">
                                <svg width="9" height="9" viewBox="0 0 6 10" fill="none">
                                    <path opacity="0.9"
                                        d="M5.96381 1.33189L2.57066 4.84441L5.96381 8.35694L4.67846 9.6875L-2.43187e-05 4.84441L4.67846 0.0013237L5.96381 1.33189Z"
                                        fill="currentColor" />
                                </svg>
                            </button>
                            <button
                                class="swiper-button-next-custom w-12 h-12 rounded-full flex items-center justify-center bg-alternate hover:bg-text hover:text-main text-heading transition-all shadow-[0px_0px_30px_0px_#1C1D580D] cursor-pointer">
                                <svg width="9" height="9" viewBox="0 0 6 10" fill="none">
                                    <path opacity="0.9"
                                        d="M0 1.33189L3.39315 4.84441L0 8.35694L1.28534 9.6875L5.96383 4.84441L1.28534 0.0013237L0 1.33189Z"
                                        fill="currentColor" />
                                </svg>

                            </button>
                        </div>
                        <div class="swiper-pagination-custom text-text font-medium">
                            <span class="active-index text-heading text-xl">1</span>/{{featured.length}}
                        </div>
                    </div>
                    <div class="thumbs-swiper-wrapper max-w-[560px]">
                        <div class="thumbs-swiper swiper">
                            <div class="swiper-wrapper gap-2.5">
                                {{#foreach featured}}
                                <div class="swiper-slide !w-auto">
                                    <div
                                        class="thumb-card w-[130px] xl:w-[180px] aspect-1/1 bg-alternate text-text rounded-lg overflow-hidden transition-all cursor-pointer">
                                        {{#if feature_image}}
                                        <img src="{{img_url feature_image size=" s"}}" alt="{{title}}"
                                            class="rounded-lg w-full h-full object-cover">
                                        {{else}}
                                        <div class="w-full h-full flex items-center justify-center">
                                            <span class="">NO IMAGE</span>
                                        </div>
                                        {{/if}}
                                    </div>
                                </div>
                                {{/foreach}}
                            </div>
                        </div>
                    </div>
                </div>
                {{/if}}
            </div>
        </div>
    </section>
    {{/if}}
    {{/get}}

    {{!-- All posts Section --}}
    <section class="latest-articles py-[70px]">
        <div class="container">
            <!-- HEADER -->
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-[25px] gap-6">
                <h2 class="text-2xl md:text-3xl tracking-tight">{{@custom.home_feed_title}}</h2>
                <div class="flex flex-wrap items-center gap-3">
                    <button class="filter-tab-btn tab-btn active px-5 py-1.5 rounded-lg text-sm border" data-tab="all">
                        All
                    </button>
                    {{#get "tags" filter="slug:[{{@custom.home_feed_tags}}]"}}
                    {{#foreach tags}}
                    <button class="filter-tab-btn tab-btn px-5 py-1.5 rounded-lg text-sm border" data-tab="{{slug}}">
                        {{name}}
                    </button>
                    {{/foreach}}
                    {{/get}}
                </div>
            </div>
            <div class="tab-content">
                <!-- ALL TAB -->
                <div id="tab-all" class="tab-grid">
                    {{#get "posts" limit="50" include="tags,authors" order="published_at desc"}}
                    <div class="posts-container grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                        {{#foreach posts}}
                        <div class="post-item hidden">
                            {{> post-card}}
                        </div>
                        {{/foreach}}
                    </div>
                    <div class="text-center mt-10">
                        <button class="show-more-btn button button-outline">
                            Show More
                        </button>
                    </div>
                    {{/get}}
                </div>
                <!-- TAG TABS -->
                {{#get "tags" filter="slug:[{{@custom.home_feed_tags}}]"}}
                {{#foreach tags}}
                <div id="tab-{{slug}}" class="tab-grid hidden">
                    {{#get "posts" limit="50" include="tags,authors" filter="tag:{{slug}}" order="published_at desc"}}
                    <div class="posts-container grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                        {{#foreach posts}}
                        <div class="post-item hidden">
                            {{> post-card}}
                        </div>
                        {{/foreach}}
                    </div>
                    <div class="text-center mt-10">
                        <button class="show-more-btn button button-outline">
                            Show More
                        </button>
                    </div>
                    {{/get}}
                </div>
                {{/foreach}}
                {{/get}}
            </div>
        </div>
    </section>

    {{!-- recommended post section --}}
    <section class="recommended-posts">
        {{#get "posts" limit="3" include="tags,authors" filter="tag:hash-recommended" order="published_at desc"}}
        <div class="flex overflow-hidden">
            {{#foreach posts}}
            <div
                class="group card relative min-h-[80dvh] p-5 flex items-center justify-center flex-1 hover:flex-[1.3] transition-all duration-400">
                <div
                    class="absolute inset-0 overflow-hidden bg-alternate text-text/50 flex items-center justify-center min-w-[50vw]">
                    {{#if feature_image}}
                    <img src="{{img_url feature_image size=" m"}}" alt="{{title}}" class="w-full h-full object-cover" />
                    {{else}}
                    <span class="font-bold">NO IMAGE</span>
                    {{/if}}
                </div>
                <article id="article-card-{{@index}}"
                    class="relative z-1 article-card group flex flex-col w-full max-w-[450px] mx-auto opacity-0 group-hover:opacity-100 transition-all duration-400 ease">
                    <div id="article-card-iamge-{{@index}}"
                        class="border-16 border-white rounded-t-xl article-card-image aspect-[3/2]"> </div>
                    <div class="bg-white p-4 pb-[0px] rounded-b-xl">
                        {{! Category Tag }}

                        {{#foreach tags visibility="public"}}
                        {{#if @first}}
                        <div class="flex gap-2 mb-4">
                            {{/if}}
                            <span
                                class="px-3 py-1 min-h-[20px] flex items-center bg-alternate rounded-sm text-xs border border-border">{{name}}</span>


                            {{#if @last}}
                        </div>
                        {{/if}}
                        {{/foreach}}
                        {{! Title }}
                        <h3 class="text-md md:text-xl mb-4 pr-[10px]"> {{title}} </h3>

                        {{! Excerpt }}
                        {{#if excerpt}}
                        <p class="line-clamp-3 mb-5 pr-[10px]"> {{excerpt}}</p>
                        {{/if}}

                        {{! Footer Metadata }}
                        <div class="mt-auto py-[15px] border-t border-border flex items-center justify-between">
                            <div class="author-group flex items-center">
                                {{#if authors}}
                                <div class="flex -space-x-3 mr-3">
                                    {{#foreach authors}}
                                    {{#if profile_image}}
                                    <img src="{{img_url profile_image size=" xs"}}" alt="{{name}}"
                                        class="w-9 h-9 rounded-full border-2 border-white object-cover shadow-sm bg-white"
                                        title="{{name}}">
                                    {{else}}
                                    <div class="w-9 h-9 rounded-full border-2 border-white bg-gray-200 flex items-center justify-center text-[10px] text-gray-500 shadow-sm"
                                        title="{{name}}">
                                        {{#if name}}{{name}}{{/if}}
                                    </div>
                                    {{/if}}
                                    {{/foreach}}
                                </div>
                                {{/if}}
                                <div class="flex flex-col justify-center">
                                    <h4 class="text-base">
                                        {{#foreach authors}}{{name}}{{#unless @last}}, {{/unless}}{{/foreach}}
                                    </h4>
                                    <span class="text-xs mt-0.5">Published on {{date format="DD MMM YYYY"}}</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <a href="{{url}}" class="overlaylink"></a>
                </article>
            </div>
            {{/foreach}}
        </div>
        {{/get}}
    </section>

    {{!-- Latest Posts Section with Dual-State Hover Effect --}}
    {{#if @custom.home_tags_section}}
    <section class="tag-posts pbs-[70px]">
        <div class="container">
            <div class="bg-alternate rounded-[30px] p-[40px]">

                {{!-- PAGE BLOCK --}}
                {{#get "pages" filter="tag:hash-categories-posts" limit="1"}}
                {{#if pages}}
                {{#foreach pages}}
                <div class="text-center max-w-2xl mx-auto mb-10">
                    <h2 class="text-4xl md:text-5xl font-bold mb-4">{{title}}</h2>
                    {{#if excerpt}}
                    <p>{{excerpt}}</p>
                    {{/if}}
                </div>
                {{/foreach}}
                {{/if}}
                {{/get}}

                {{!-- TAGS BLOCK --}}
                {{#get "tags" filter="slug:[{{@custom.home_tags_section}}]"}}
                {{#if tags}}

                {{#foreach tags}}
                <div class="mb-12">
                    <h2 class="text-xl mb-6">{{name}}</h2>
                    {{#get "posts" limit="4" include="tags,authors" filter="tag:{{slug}}" order="published_at desc"}}

                    {{#if posts}}
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
                        {{#foreach posts}}
                        <a href="{{url}}"
                            class="group relative flex flex-col bg-[#F3F7F7] rounded-[10px] overflow-hidden aspect-[3/4] cursor-pointer">

                            {{!-- Enhanced Image Expansion Layer --}}
                            <div
                                class="absolute inset-0 m-auto [clip-path:circle(25%_at_50%_45%)] group-hover:[clip-path:circle(100%_at_50%_50%)] overflow-hidden transition-all duration-700 ease-in-out">
                                {{#if feature_image}}
                                <img src="{{img_url feature_image size=" l"}}" alt="{{title}}"
                                    class="w-full h-full object-cover">
                                {{/if}}
                            </div>

                            {{!-- Normal State Content --}}
                            <div class="relative flex flex-col h-full justify-between px-[14px] py-[20px]">
                                <div class="flex gap-2">
                                    {{#foreach tags}}
                                    <span
                                        class="px-4 py-1 min-h-[20px] flex items-center bg-white rounded-sm text-xs border group-hover:text-white group-hover:bg-[#F4F4F433] group-hover:backdrop-blur-2xl transition-all ease-in">{{name}}</span>
                                    {{/foreach}}
                                </div>
                                <div class="w-full">
                                    <span
                                        class="text-xs font-medium mb-1 text-white opacity-0 group-hover:opacity-70 transition-all ease-in">{{date
                                        format="MMM DD, YYYY"}}</span>
                                    <h3 class="text-base font-bold group-hover:text-white transition-all ease-in">
                                        {{title}}
                                    </h3>
                                </div>
                            </div>
                        </a>
                        {{/foreach}}
                    </div>
                    {{else}}
                    <div class="py-10 text-center text-gray-400">
                        No posts found in {{name}}
                    </div>
                    {{/if}}

                    {{/get}}
                </div>
                {{/foreach}}

                {{/if}}
                {{/get}}

            </div>
        </div>
    </section>
    {{/if}}

    {{!-- Read by Category Section --}}
    <section class="pbs-[70px]">
        <div class="container">
            <div class="flex items-center justify-between mb-[25px]">
                <h2 class="text-2xl md:text-3xl font-bold tracking-tight">{{@custom.category_title}}</h2>
            </div>
            {{#get "tags" limit="all" include="count.posts" order="count.posts desc"}}
            <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-6">
                {{#foreach tags}}
                <a href="{{url}}" class="group flex flex-col gap-3">
                    <div
                        class="relative aspect-square bg-[#F3F4F6] text-[#dbdbdb] flex items-center justify-center rounded-lg overflow-hidden">
                        {{#if feature_image}}
                        <img src="{{img_url feature_image size=" s"}}" alt="{{name}}"
                            class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500 ease-in-out">
                        {{else}}
                        <span class="font-bold">NO IMAGE</span>
                        {{/if}}
                        <div
                            class="absolute inset-0 bg-black/5 opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none">
                        </div>
                    </div>
                    <div class="flex flex-col">
                        <h3 class="text-base leading-tight">{{name}}</h3>
                        <span class="text-xs mt-1.5">{{count.posts}} articles</span>
                    </div>
                </a>
                {{/foreach}}
            </div>
            {{/get}}
        </div>
    </section>

    {{!-- Newsletter Hero Section --}}
    <section class="py-[70px] relative overflow-hidden" {{#if @custom.banner_background_image}}
        style="background-image: url('{{img_url @custom.banner_background_image}}');" {{/if}}>
        {{!-- Wavy Background Element --}}
        <div class="absolute inset-0 z-0 pointer-events-none opacity-40">
            <svg viewBox="0 0 1440 600" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full opacity-30">
                <path d="M0 250C320 350 480 150 720 250C960 350 1120 150 1440 250V600H0V250Z"
                    fill="url(#hero-gradient)" />
                <defs>
                    <linearGradient id="hero-gradient" x1="720" y1="200" x2="720" y2="600"
                        gradientUnits="userSpaceOnUse">
                        <stop stop-color="#F5F3FF" />
                        <stop offset="1" stop-color="white" />
                    </linearGradient>
                </defs>
            </svg>
        </div>

        <div class="container relative text-center ">
            {{!-- Overlapping Images Design --}}
            {{#get "posts" limit="3" filter="tag:hash-custom" include="tags"}}
            {{log posts "jhghjghhjhj"}}
            <div class="flex items-center justify-center mb-12 select-none pointer-events-none md:pointer-events-auto">

                {{!-- CASE: 3 POSTS --}}
                {{#match posts.length ">=" 3}}

                <!-- LEFT -->
                <div
                    class="w-[100px] md:w-[150px] aspect-square rounded-lg overflow-hidden border-[2px] border-white -rotate-[15deg] translate-x-[25px] translate-y-[10px]">
                    {{#with posts.[0]}}
                    {{#if feature_image}}
                    <img src="{{img_url feature_image}}" class="w-full h-full object-cover">
                    {{/if}}
                    {{/with}}
                    <a href="{{url}}" class="overlaylink"></a>
                </div>

                <!-- CENTER -->
                <div
                    class="w-[150px] md:w-[200px] aspect-square rounded-lg overflow-hidden border-[2px] border-white relative z-2">
                    {{#with posts.[1]}}
                    {{#if feature_image}}
                    <img src="{{img_url feature_image}}" class="w-full h-full object-cover">
                    {{/if}}
                    {{/with}}
                    <a href="{{url}}" class="overlaylink"></a>
                </div>

                <!-- RIGHT -->
                <div
                    class="w-[100px] md:w-[150px] aspect-square rounded-lg overflow-hidden border-[2px] border-white rotate-[15deg] -translate-x-[25px] translate-y-[10px]">
                    {{#with posts.[2]}}
                    {{#if feature_image}}
                    <img src="{{img_url feature_image}}" class="w-full h-full object-cover">
                    {{/if}}
                    {{/with}}
                    <a href="{{url}}" class="overlaylink"></a>
                </div>

                {{!-- CASE: 2 POSTS --}}
                {{else}}
                {{#match posts.length "=" 2}}

                <!-- CENTER -->
                <div
                    class="w-[150px] md:w-[200px] aspect-square rounded-lg overflow-hidden border-[2px] border-white relative z-2">
                    {{#with posts.[0]}}
                    {{#if feature_image}}
                    <img src="{{img_url feature_image}}" class="w-full h-full object-cover">
                    {{/if}}
                    {{/with}}
                    <a href="{{url}}" class="overlaylink"></a>
                </div>

                <!-- RIGHT -->
                <div
                    class="w-[100px] md:w-[150px] aspect-square rounded-lg overflow-hidden border-[2px] border-white rotate-[15deg] -translate-x-[25px] translate-y-[10px]">
                    {{#with posts.[1]}}
                    {{#if feature_image}}
                    <img src="{{img_url feature_image}}" class="w-full h-full object-cover">
                    {{/if}}
                    {{/with}}
                    <a href="{{url}}" class="overlaylink"></a>
                </div>

                {{!-- CASE: 1 POST --}}
                {{else}}
                {{#match posts.length "=" 1}}

                <!-- CENTER -->
                <div
                    class="w-[150px] md:w-[200px] aspect-square rounded-lg overflow-hidden border-[2px] border-white relative z-2">
                    {{#with posts.[0]}}
                    {{#if feature_image}}
                    <img src="{{img_url feature_image}}" class="w-full h-full object-cover">
                    {{/if}}
                    {{/with}}
                    <a href="{{url}}" class="overlaylink"></a>
                </div>

                {{!-- CASE: 0 POSTS --}}
                {{else}}

                <!-- FALLBACK: SITE COVER -->
                {{#if @site.cover_image}}
                <div class="w-[150px] md:w-[200px] aspect-square rounded-lg overflow-hidden border-[2px] border-white">
                    <img src="{{@site.cover_image}}" class="w-full h-full object-cover">
                </div>
                {{/if}}

                {{/match}}
                {{/match}}
                {{/match}}


            </div>

            {{/get}}
            {{#get "pages" filter="tag:hash-static-text-section" limit="1"}}
            {{#if pages}}
            {{#foreach pages}}
            <h2 class="text-3xl md:text-4xl lg:text-5xl leading-[1.05] mb-6">
                {{title}}
            </h2>
            <p class="text-base mb-10 max-w-2xl mx-auto">
                {{excerpt}}
            </p>
            {{/foreach}}
            {{/if}}
            {{/get}}

            {{#match @custom.hero_actions "Subscription form"}}
            <form class="flex flex-col md:flex-row items-center justify-center gap-3.5 max-w-lg mx-auto">
                <input type="email" placeholder="Your Email"
                    class="w-full px-6 py-3 rounded-lg border border-transparent bg-white shadow-[0_2px_15px_-3px_rgba(0,0,0,0.08),0_10px_20px_-2px_rgba(0,0,0,0.04)] text-gray-900 placeholder:text-gray-400 focus:border-[#6366F1]/30 focus:ring-4 focus:ring-[#6366F1]/5 transition-all outline-none"
                    required>
                <button type="submit"
                    class="w-full md:w-auto min-w-[140px] px-8 py-3 rounded-lg bg-[#5ECC1D] hover:bg-[#52B418] text-white font-bold transition-all shadow-lg hover:shadow-xl active:scale-[0.98]">
                    Subscribe
                </button>
            </form>
            {{else}}
            {{#match @custom.hero_actions "Social links"}}
            <div>
                <p>ye wale social links hai</p>
            </div>
            {{/match}}
            {{/match}}


        </div>



    </section>

    {{!-- Meet the Authors Section --}}
    {{#get "pages" filter="tag:hash-authors-section" limit="1" include ="tags"}}
    {{#if pages}}
    {{#foreach pages}}
    {{#has tag="#no-title"}}
    {{!-- do nothing --}}
    {{else}}
    <section class="py-[70px] bg-alternate">
        <div class="container">
            <div class="flex items-center justify-between mb-[25px]">
                <h2 class="text-2xl md:text-3xl font-bold tracking-tight">{{title}}</h2>
                <a href={{url}} class="text-sm font-medium flex items-center gap-2 group/link">
                    <span>View All</span>
                    <svg class="w-4 h-4 transform group-hover/link:translate-x-1 transition-transform"
                        viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                        stroke-linejoin="round">
                        <path d="M5 12h14M12 5l7 7-7 7" />
                    </svg>
