                        class="relative w-[100px] md:w-[150px] aspect-square rounded-lg overflow-hidden border-[2px] border-alternate text-text/20 flex items-center justify-center rotate-[15deg] -translate-x-[25px] translate-y-[10px]">
                        {{#with posts.[1]}}
                        {{#if feature_image}}
                        <img src="{{img_url feature_image}}" class="w-full h-full object-cover">
                        {{else}}
                        <span class="font-bold">NO IMAGE</span>
                        {{/if}}
