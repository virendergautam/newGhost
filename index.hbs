{{!< default}}
{{!-- The tag above means: insert everything in this file
into the {body} of the default.hbs template --}}


<main id="site-main" class="site-main outer">
{{!-- Featured Slider Section --}}
{{#get "posts" limit="5" include="tags,authors" as |featured|}}
    {{#if featured}}
        <section class="featured-slider py-[50px] border-be border-[#E5E7EB] bg-[#E7E8E9]">
            <div class="container">
                <div class="main-swiper swiper overflow-hidden relative">
                    <div class="swiper-wrapper">
                        {{#foreach featured}}
                            <div class="swiper-slide flex flex-col justify-center">
                                {{!-- Main Content Wrapper: Groups Text and Image --}}
                                <div class="featured-slider-card h-full grid grid-cols-1 lg:grid-cols-[1fr_1.4fr] gap-12">
                                    {{!-- Text Content --}}
                                    <div class="slide-content space-y-6">
                                        <div class="flex items-center gap-4">
                                            <div class="flex gap-2">
                                                {{#foreach tags}}
                                                    <span
                                                    class="px-4 py-1 min-h-[20px] flex items-center bg-white rounded-sm text-xs border"
                                                    >{{name}}</span>
                                                {{/foreach}}
                                            </div>
                                            <span class="text-xs font-medium">{{reading_time}}</span>
                                        </div>

                                        <h2 class="text-5xl">
                                            <a href="{{url}}">{{title}}</a>
                                        </h2>

                                        <p class="text-sm line-clamp-3 max-w-xl">
                                            {{excerpt}}
                                        </p>

                                        {{#foreach authors}}
                                            <div class="flex items-center gap-3">
                                                {{#if profile_image}}
                                                    <img src="{{img_url profile_image size="xs"}}" alt="{{name}}" class="w-12 h-12 rounded-full object-cover shadow-md">
                                                {{/if}}
                                                <div>
                                                    <div class="font-bold text-gray-900 leading-none">{{name}}</div>
                                                    <div class="text-xs text-gray-400 mt-1">Published on {{date format="DD MMM YYYY"}}</div>
                                                </div>
                                            </div>
                                        {{/foreach}}
                                    </div>

                                    {{!-- Right Large Image --}}
                                    <div class="relative bg-gray-200 min-h-[650px] h-full rounded-[20px] overflow-hidden flex items-center justify-center">
                                        {{#if feature_image}}
                                            <img src="{{img_url feature_image size="l"}}" alt="{{title}}" class="w-full h-full object-cover">
                                        {{else}}
                                            <span class="text-gray-400">Featured Image Not Set</span>
                                        {{/if}}
                                    </div>
                                </div>
                            </div>
                        {{/foreach}}
                    </div>
                    <div class="navigation-wrapper absolute z-1 bottom-[40px] left-0 w-full max-w-[56%] flex items-end justify-between gap-12 p-[10px] bg-[##E7E8E9] rounded-lg">
                        <div class="flex items-center gap-5">
                            <div class="flex gap-2">
                                <button class="swiper-button-prev-custom w-12 h-12 rounded-full flex items-center justify-center bg-white hover:bg-gray-50 transition-all shadow-sm border border-gray-100 cursor-pointer">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
                                </button>
                                <button class="swiper-button-next-custom w-12 h-12 rounded-full flex items-center justify-center bg-white hover:bg-gray-50 transition-all shadow-sm border border-gray-100 cursor-pointer">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                                </button>
                            </div>
                            <div class="swiper-pagination-custom text-gray-400 font-medium min-w-[40px]">
                                <span class="active-index text-gray-900">1</span>/{{featured.length}}
                            </div>
                        </div>

                        {{!-- Thumbnail Slider relocated here --}}
                        <div class="thumbs-swiper swiper max-w-sm !mx-0">
                            <div class="swiper-wrapper gap-2.5">
                                {{#foreach featured}}
                                    <div class="swiper-slide !w-auto">
                                        <div class="thumb-card w-[130px] xl:w-[180px] aspect-4/3 bg-gray-200 rounded-lg overflow-hidden transition-all cursor-pointer">
                                            {{#if feature_image}}
                                                <img src="{{img_url feature_image size="s"}}" alt="{{title}}" class="rounded-lg w-full h-full object-cover">
                                            {{else}}
                                                 <div class="w-full h-full flex items-center justify-center">
                                                     <span class="">No Img</span>
                                                 </div>
                                            {{/if}}
                                        </div>
                                    </div>
                                {{/foreach}}
                            </div>
                        </div>
                    </div>
            
                </div>
            </div>
        </section>
        {{/if}}
    {{/get}}
    <section class="py-[50px] bg-[#E7E8E9]">
        <div class="container">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-[25px] gap-6">
                <h2 class="text-3xl md:text-4xl tracking-tight">New Articles</h2>
                <div class="flex flex-wrap items-center gap-3">
                    <button class="filter-tab-btn tab-btn active px-5 py-1.5 rounded-lg text-sm border transition-all cursor-pointer" data-tab="all">All</button>
                    {{#get "tags" limit="3" include="count.posts" order="count.posts desc"}}
                        {{#foreach tags}}
                            <button class="filter-tab-btn tab-btn px-5 py-1.5 rounded-lg text-sm border transition-all cursor-pointer" data-tab="{{slug}}">{{name}}</button>
                        {{/foreach}}
                    {{/get}}
                </div>
            </div>
            <div class="tab-content">
                <div id="tab-all" class="tab-grid">
                    {{#get "posts" limit="8" include="tags,authors" order="published_at desc"}}
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                            {{#foreach posts}}
                                {{> post-card}}
                            {{/foreach}}
                        </div>
                    {{/get}}
                </div>
                {{#get "tags" limit="3" include="count.posts" order="count.posts desc"}}
                    {{#foreach tags}}
                        <div id="tab-{{slug}}" class="tab-grid hidden">
                            {{#get "posts" limit="8" include="tags,authors" filter="tag:{{slug}}" order="published_at desc"}}
                                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                                    {{#foreach posts}}
                                        {{> post-card}}
                                    {{else}}
                                        <div class="col-span-full py-20 text-center text-gray-400">No articles found in {{name}}.</div>
                                    {{/foreach}}
                                </div>
                            {{/get}}
                        </div>
                    {{/foreach}}
                {{/get}}
            </div>
        </div>
    </section>

    <script>
    document.addEventListener('DOMContentLoaded', function() {
        const thumbsSwiper = new Swiper(".thumbs-swiper", {
            slidesPerView: "auto",
            freeMode: true,
            watchSlidesVisibility: true,
            watchSlidesProgress: true,
        });

        const mainSwiper = new Swiper(".main-swiper", {
            spaceBetween: 10,
            effect: 'fade',
            fadeEffect: {
                crossFade: true
            },
            thumbs: {
                swiper: thumbsSwiper,
            },
            navigation: {
                nextEl: ".swiper-button-next-custom",
                prevEl: ".swiper-button-prev-custom",
            },
            on: {
                slideChange: function () {
                    const activeIndex = this.realIndex + 1;
                    document.querySelector('.active-index').textContent = activeIndex;
                }
            }
        });

        // Tab Switching Logic
        const tabBtns = document.querySelectorAll('.tab-btn');
        const tabGrids = document.querySelectorAll('.tab-grid');
        const viewAllLink = document.getElementById('view-all-link');

        tabBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                const tabId = btn.getAttribute('data-tab');
                
                // Update buttons
                tabBtns.forEach(b => {
                    b.classList.remove('active');
                });
                btn.classList.add('active');

                // Update grids
                tabGrids.forEach(grid => grid.classList.add('hidden'));
                document.getElementById(`tab-${tabId}`).classList.remove('hidden');

                // Update View All link if needed
                if (tabId === 'all') {
                    viewAllLink.href = '/archive';
                } else {
                    viewAllLink.href = `/tag/${tabId}`;
                }
            });
        });
    });
    </script>
</main>
